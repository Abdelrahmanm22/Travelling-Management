@model Travel.Presentation.ViewModels.NationalityViewModel
@{
    ViewData["Title"] = "New Nationality";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">New Nationality</h4>

                <form asp-action="Create" method="post" id="nationality-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <partial name="_NationalityForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Nationality</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
