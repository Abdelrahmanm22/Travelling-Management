@model Travel.Presentation.ViewModels.NationalityViewModel

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Egyptian, British, German" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <small class="text-muted">Shown in the nationality dropdown on the booking form.</small>
</div>
