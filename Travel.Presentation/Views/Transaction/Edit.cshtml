@model Travel.Presentation.ViewModels.TransactionFormViewModel
@{
    ViewData["Title"] = "Edit Payment";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <h4 class="card-title mb-0"><i class="bx bx-wallet me-1"></i> Edit Payment</h4>
                    <span class="badge bg-info-subtle text-info">
                        <i class="bx bx-history me-1"></i> Changes are recorded in the booking's audit trail
                    </span>
                </div>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <partial name="_TransactionForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/attachment-dropzones.js"></script>
}
