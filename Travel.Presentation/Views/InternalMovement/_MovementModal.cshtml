@model InternalMovementDayViewModel

@* One shared dialog, filled from the dropped-on card(s) by internal-movements.js. Rendered outside
   every form, and its inputs carry no name: nothing here posts except through the script's JSON save. *@
<div class="modal fade" id="movement-modal" tabindex="-1" aria-labelledby="mv-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mv-modal-title">New movement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="mv-errors" role="alert"></div>

                <div class="mb-3">
                    <label class="form-label" for="mv-type-select">Movement type</label>
                    <div id="mv-type-static" class="mv-type-static d-none"></div>
                    <select id="mv-type-select" class="form-select">
                        <option value="">Choose a type…</option>
                        @foreach (var type in Model.Types)
                        {
                            <option value="@type.Id" data-leg="@((int?)type.FlightLeg)">@type.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label mb-1">Bookings</label>
                    <div id="mv-bookings" class="d-flex flex-column gap-2"></div>
                </div>

                <div class="row g-2">
                    <div class="col-sm-5">
                        <label class="form-label" for="mv-time">Pickup time</label>
                        <input type="time" id="mv-time" class="form-control" />
                        <small class="text-muted d-none" id="mv-time-note">From the landing time.</small>
                    </div>
                    <div class="col-sm-7">
                        <label class="form-label" for="mv-driver">Driver</label>
                        <select id="mv-driver" class="form-select">
                            <option value="">Choose a driver…</option>
                            @foreach (var driver in Model.Drivers)
                            {
                                <option value="@driver.Id">@driver.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-soft-danger me-auto d-none" id="mv-delete">
                    <i class="bx bx-trash me-1"></i>Delete
                </button>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="mv-save">Save</button>
            </div>
        </div>
    </div>
</div>

<template id="mv-booking-template">
    <div class="mv-modal-booking">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="min-width-0">
                <span class="badge bg-primary-subtle text-primary font-monospace mv-modal-code"></span>
                <span class="fw-bold mv-modal-lead"></span>
                <div class="small mv-modal-flight"></div>
            </div>
            <div class="input-group input-group-sm mv-modal-pax">
                <span class="input-group-text">Pax</span>
                <input type="number" class="form-control" min="1" step="1" />
            </div>
        </div>
    </div>
</template>
