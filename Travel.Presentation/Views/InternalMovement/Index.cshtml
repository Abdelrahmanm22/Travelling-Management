@model InternalMovementIndexViewModel
@{
    ViewData["Title"] = "Internal Movements";
}

@if (Model.Destinations.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <div class="avatar-sm mx-auto mb-3">
                <span class="avatar-title rounded-circle bg-primary-subtle text-primary">
                    <i class="bx bxs-car font-size-24"></i>
                </span>
            </div>
            <h5>No destination takes internal movements yet</h5>
            <p class="text-muted mb-3">
                Turn on <strong>Has internal movements</strong> for a destination (usually Cairo) under Setup ▸ Destinations,
                and its calendar appears here.
            </p>
            <permission required="@Permissions.Destinations.View">
                <a asp-controller="Destination" asp-action="Index" class="btn btn-primary">
                    <i class="bx bx-map-pin me-1"></i> Open Destinations
                </a>
            </permission>
        </div>
    </div>
}
else
{
    @* Cards h-100 so rows align. No masonry: it breaks tab order. *@
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var destination in Model.Destinations)
        {
            <div class="col">
                <a asp-action="Calendar" asp-route-destinationId="@destination.Id" class="card h-100 mv-destination-card text-reset">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="avatar-sm flex-shrink-0">
                            <span class="avatar-title rounded-circle bg-primary-subtle text-primary">
                                <i class="bx bx-map-pin font-size-20"></i>
                            </span>
                        </div>
                        <div class="flex-grow-1 min-width-0">
                            <h5 class="mb-1 text-truncate">@destination.Name.Trim()</h5>
                            <span class="text-muted small">Open the movements calendar</span>
                        </div>
                        <i class="bx bx-chevron-right font-size-20 text-muted"></i>
                    </div>
                </a>
            </div>
        }
    </div>
}
