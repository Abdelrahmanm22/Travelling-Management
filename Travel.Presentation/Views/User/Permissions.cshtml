@model Travel.Presentation.ViewModels.UserPermissionsViewModel
@{
    ViewData["Title"] = "Direct Permissions";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
                    <div>
                        <h4 class="card-title mb-1">Direct permissions — @Model.FullName</h4>
                        <p class="text-muted mb-0">
                            Grant extra permissions on top of what this user's roles already allow.
                            Role-granted permissions are locked here — change the role to alter those.
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-info-subtle text-info me-1">@Model.InheritedCount inherited</span>
                        <span class="badge bg-primary-subtle text-primary">@Model.DirectCount direct</span>
                    </div>
                </div>

                @if (Model.Roles.Count > 0)
                {
                    <div class="mb-3">
                        <span class="text-muted me-2">Roles:</span>
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary-subtle text-primary me-1">@role</span>
                        }
                    </div>
                }

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4 text-muted font-size-12">
                    <span class="d-inline-flex align-items-center gap-2">
                        <span class="perm-legend-dot perm-legend-granted"></span> granted directly
                    </span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span class="perm-legend-dot perm-legend-inherited"></span>
                        <i class="bx bx-lock-alt text-success"></i> granted by a role — change the role to edit
                    </span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span class="perm-legend-dot"></span> not granted
                    </span>
                </div>

                <form asp-action="Permissions" method="post" id="user-permissions-form">
                    <input type="hidden" asp-for="UserId" />

                    <partial name="_PermissionModules" model="Model.Groups" />

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Permissions</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/back/assets/js/role-permissions.js"></script>
}
