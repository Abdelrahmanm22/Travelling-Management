@model Travel.Presentation.ViewModels.DriverViewModel

@* Shared by Create and Edit so the two can't drift. *@
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Ahmed Hassan" />
    <span asp-validation-for="Name" class="text-danger"></span>
    <small class="text-muted">Shown in the driver picker on the movements board and on the drivers' sheet.</small>
</div>

<div class="form-check form-switch mb-3">
    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
    <label asp-for="IsActive" class="form-check-label"></label>
    <div><small class="text-muted">An inactive driver stays on the movements already assigned to them, but can't be picked for new ones.</small></div>
</div>
