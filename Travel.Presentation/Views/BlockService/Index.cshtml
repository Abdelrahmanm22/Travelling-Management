@model BlockServiceListViewModel
@using Travel.Domain.Enums
@using Travel.Domain.Services.BlockServices
@{
    ViewData["Title"] = "Block Services";

    string RoomAbbr(RoomType t) => t == RoomType.Single ? "SGL" : t == RoomType.Double ? "DBL" : "TRP";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="applied" value="true" />
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="From" class="form-label"></label>
                        <input asp-for="From" type="date" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="To" class="form-label"></label>
                        <input asp-for="To" type="date" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <label asp-for="DestinationId" class="form-label"></label>
                        <select asp-for="DestinationId" asp-items="Model.DestinationOptions" class="form-select">
                            <option value="">All destinations</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3 text-sm-end">
                        <button type="submit" class="btn btn-primary waves-effect waves-light">
                            <i class="bx bx-filter-alt me-1"></i> Apply
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <i class="bx bx-x me-1"></i> Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-1">Block Services</h4>
                        <p class="card-title-desc mb-0">
                            Bookings that check into the same destination on the same date, grouped into one file per supplier.
                        </p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">
                        @Model.Blocks.Count block@(Model.Blocks.Count == 1 ? "" : "s")
                    </span>
                </div>

                @if (Model.Blocks.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bx bx-layer text-muted" style="font-size:3rem"></i>
                        <h5 class="mt-3">No blocks in this range</h5>
                        <p class="text-muted mb-0">
                            A block appears once <strong>two or more bookings</strong> check into the same destination
                            on the same date. Try widening the date range or clearing the destination filter.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="blocks-table" class="table table-hover align-middle mb-0" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Destination</th>
                                    <th>Check-in</th>
                                    <th>Nights</th>
                                    <th>Bookings</th>
                                    <th>PAX</th>
                                    <th>Rooms</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Blocks)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @if (b.IsCruise)
                                            {
                                                <i class="bx bxs-ship me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bx bx-buildings me-1"></i>
                                            }
                                            @b.DestinationName
                                        </td>
                                        <td data-order="@b.CheckInDate.ToString("yyyy-MM-dd")">@b.CheckInDate.ToString("dd MMM yyyy")</td>
                                        <td>@(b.MinNights == b.MaxNights ? $"{b.MinNights}" : $"{b.MinNights}–{b.MaxNights}")</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary">@b.BookingCount</span>
                                        </td>
                                        <td>
                                            @b.TotalPax
                                            @{
                                                var parts = new List<string> { $"{b.Adults}A" };
                                                if (b.Children > 0) parts.Add($"{b.Children}C");
                                                if (b.Infants > 0) parts.Add($"{b.Infants}I");
                                            }
                                            <small class="text-muted">(@string.Join(" · ", parts))</small>
                                        </td>
                                        <td class="text-nowrap">
                                            @if (b.Rooms.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                foreach (var r in b.Rooms)
                                                {
                                                    <span class="badge bg-info-subtle text-info me-1">@r.Quantity @RoomAbbr(r.Type)</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="Details"
                                               asp-route-destinationId="@b.DestinationId"
                                               asp-route-checkIn="@b.CheckInDate.ToString("yyyy-MM-dd")"
                                               class="btn btn-sm btn-soft-primary">
                                                <i class="bx bx-file me-1"></i> Open file
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            // Column indices are positional — adding a column means bumping these too.
            $('#blocks-table').DataTable({ order: [[1, 'asc']], columnDefs: [{ orderable: false, targets: [5, 6] }] });
        });
    </script>
}
