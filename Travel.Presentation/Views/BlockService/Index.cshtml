@model BlockServiceListViewModel
@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@using Travel.Domain.Services.BlockServices
@{
    ViewData["Title"] = "Group Arrivals";

    string RoomAbbr(RoomType t) => t == RoomType.Single ? "SGL" : t == RoomType.Double ? "DBL" : "TRP";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

@* This page's only POST is the status change, which block-status.js sends via AJAX. *@
@Html.AntiForgeryToken()

<partial name="_ArrivalFilters" model="Model" />

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-1">Group Arrivals</h4>
                        <p class="card-title-desc mb-0">
                            Bookings that check into the same destination on the same date, grouped into one file per supplier.
                        </p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">
                        @Model.Blocks.Count group@(Model.Blocks.Count == 1 ? "" : "s")
                    </span>
                </div>

                @if (Model.Blocks.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bx bx-layer text-muted" style="font-size:3rem"></i>
                        <h5 class="mt-3">No group arrivals in this range</h5>
                        <p class="text-muted mb-0">
                            A group appears once <strong>two or more bookings</strong> check into the same destination
                            on the same date.
                            @if (Model.Singles.Count > 0)
                            {
                                @* Don't send the operator off widening filters when the arrivals are
                                   right there — they're just all singles. *@
                                <text>
                                    Every arrival in this range is a single booking — they're listed under
                                    <a asp-action="SingleArrivals"
                                       asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                                       asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                                       asp-route-destinationId="@Model.DestinationId"
                                       asp-route-category="@Model.Category"
                                       asp-route-applied="true">Single arrivals</a>.
                                </text>
                            }
                            else
                            {
                                <text>Try widening the date range or clearing the destination filter.</text>
                            }
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="blocks-table" class="table table-hover align-middle mb-0" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Destination</th>
                                    <th>Check-in</th>
                                    <th>Nights</th>
                                    <th>Bookings</th>
                                    <th>PAX</th>
                                    <th>Rooms</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Blocks)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @if (b.IsCruise)
                                            {
                                                <i class="bx bxs-ship me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bx bx-buildings me-1"></i>
                                            }
                                            @b.DestinationName
                                            @* Inside the Destination cell, not a column of its own, so no
                                               DataTables positional index moves. The 4★ and 5★ rows of
                                               one date are separate blocks and sort side by side. *@
                                            <span class="@CategoryBadges.Css(b.Category) ms-1">@CategoryBadges.Short(b.Category)</span>
                                            @if (b.IsPrivate)
                                            {
                                                @* Inline, like the category badge — no DataTables index moves. *@
                                                <span class="@CategoryBadges.PrivateCss ms-1"><i class="bx bx-lock-alt me-1"></i>Private · @b.PrivateBookingCode</span>
                                            }
                                            @if (b.MissingDomesticFlightCount > 0)
                                            {
                                                @* Native title, not a Bootstrap tooltip — those render
                                                   detached in this template and aren't used anywhere. *@
                                                <i class="bx bx-error-circle text-danger ms-1"
                                                   title="@b.MissingDomesticFlightCount of @b.BookingCount booking@(b.BookingCount == 1 ? "" : "s") missing domestic flight documents"
                                                   aria-label="Missing domestic flight documents"></i>
                                            }
                                        </td>
                                        <td data-order="@b.CheckInDate.ToString("yyyy-MM-dd")">@b.CheckInDate.ToString("dd MMM yyyy")</td>
                                        <td>@(b.MinNights == b.MaxNights ? $"{b.MinNights}" : $"{b.MinNights}–{b.MaxNights}")</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary">@b.BookingCount</span>
                                        </td>
                                        <td>
                                            @b.TotalPax
                                            @{
                                                var parts = new List<string> { $"{b.Adults}A" };
                                                if (b.Children > 0) parts.Add($"{b.Children}C");
                                                if (b.Infants > 0) parts.Add($"{b.Infants}I");
                                            }
                                            <small class="text-muted">(@string.Join(" · ", parts))</small>
                                        </td>
                                        <td class="text-nowrap">
                                            @if (b.Rooms.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                foreach (var r in b.Rooms)
                                                {
                                                    <span class="badge bg-info-subtle text-info me-1">@r.Quantity @RoomAbbr(r.Type)</span>
                                                }
                                            }
                                        </td>
                                        <td data-order="@((int)b.Status.Status)">
                                            <partial name="_BlockStatusCell" model="b" />
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="Details"
                                               target="_blank"
                                               asp-route-destinationId="@b.DestinationId"
                                               asp-route-checkIn="@b.CheckInDate.ToString("yyyy-MM-dd")"
                                               asp-route-category="@b.Category"
                                               asp-route-privateBookingId="@b.PrivateBookingId"
                                               class="btn btn-sm btn-soft-primary">
                                                <i class="bx bx-file me-1"></i> Open file
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<permission required="@Permissions.BlockServices.ChangeStatus">
    <partial name="_BlockStatusModal" />
</permission>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            // Column indices are positional — adding a column means bumping these too. SingleArrivals
            // has no "Bookings" column, so its indices are one lower; the two configs must stay apart.
            $('#blocks-table').DataTable({ order: [[1, 'asc']], columnDefs: [{ orderable: false, targets: [5, 7] }] });
        });

        window.blockStatusConfig = {
            url: '@Url.Action("SetStatus")',
            token: $('input[name="__RequestVerificationToken"]').val()
        };
    </script>
    <script src="~/back/assets/js/block-status.js"></script>
}
