@model BlockServiceListViewModel
@using Travel.Domain.Enums
@using Travel.Domain.Services.BlockServices
@{
    ViewData["Title"] = "Single Arrivals";

    string RoomAbbr(RoomType t) => t == RoomType.Single ? "SGL" : t == RoomType.Double ? "DBL" : "TRP";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

@* This page's only POST is the status change, which block-status.js sends via AJAX. *@
@Html.AntiForgeryToken()

<partial name="_ArrivalFilters" model="Model" />

@if (Model.Blocks.Count > 0)
{
    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center flex-wrap gap-2" role="alert">
        <i class="bx bx-info-circle font-size-18"></i>
        <div class="flex-grow-1">
            <strong>@Model.Blocks.Count block@(Model.Blocks.Count == 1 ? "" : "s")</strong>
            in this range @(Model.Blocks.Count == 1 ? "is" : "are") shared by two or more bookings.
        </div>
        <a asp-action="Index"
           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
           asp-route-destinationId="@Model.DestinationId"
           asp-route-applied="true"
           class="btn btn-sm btn-soft-info">
            <i class="bx bx-layer me-1"></i> Back to Block Services
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-1">Single Arrivals</h4>
                        <p class="card-title-desc mb-0">
                            Destination and check-in dates reached by exactly one booking. They still get the
                            same file as a block — the supplier needs the rooming list either way.
                        </p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">
                        @Model.Singles.Count arrival@(Model.Singles.Count == 1 ? "" : "s")
                    </span>
                </div>

                @if (Model.Singles.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bx bx-user text-muted" style="font-size:3rem"></i>
                        <h5 class="mt-3">No single arrivals in this range</h5>
                        <p class="text-muted mb-0">
                            @if (Model.Blocks.Count > 0)
                            {
                                <text>Every arrival here is shared by two or more bookings — see Block Services.</text>
                            }
                            else
                            {
                                <text>Try widening the date range or clearing the destination filter.</text>
                            }
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="singles-table" class="table table-hover align-middle mb-0" style="width:100%">
                            <thead class="table-light">
                                <tr>
                                    <th>Destination</th>
                                    <th>Check-in</th>
                                    <th>Nights</th>
                                    <th>PAX</th>
                                    <th>Rooms</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Singles)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @if (b.IsCruise)
                                            {
                                                <i class="bx bxs-ship me-1"></i>
                                            }
                                            else
                                            {
                                                <i class="bx bx-buildings me-1"></i>
                                            }
                                            @b.DestinationName
                                            @if (b.MissingDomesticFlightCount > 0)
                                            {
                                                @* One booking per group here, so no count is needed. *@
                                                <i class="bx bx-error-circle text-danger ms-1"
                                                   title="Domestic flight document missing"
                                                   aria-label="Missing domestic flight document"></i>
                                            }
                                        </td>
                                        <td data-order="@b.CheckInDate.ToString("yyyy-MM-dd")">@b.CheckInDate.ToString("dd MMM yyyy")</td>
                                        <td>@b.MinNights</td>
                                        <td>
                                            @b.TotalPax
                                            @{
                                                var parts = new List<string> { $"{b.Adults}A" };
                                                if (b.Children > 0) parts.Add($"{b.Children}C");
                                                if (b.Infants > 0) parts.Add($"{b.Infants}I");
                                            }
                                            <small class="text-muted">(@string.Join(" · ", parts))</small>
                                        </td>
                                        <td class="text-nowrap">
                                            @if (b.Rooms.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                foreach (var r in b.Rooms)
                                                {
                                                    <span class="badge bg-info-subtle text-info me-1">@r.Quantity @RoomAbbr(r.Type)</span>
                                                }
                                            }
                                        </td>
                                        <td data-order="@((int)b.Status.Status)">
                                            <partial name="_BlockStatusCell" model="b" />
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-action="Details"
                                               asp-route-destinationId="@b.DestinationId"
                                               asp-route-checkIn="@b.CheckInDate.ToString("yyyy-MM-dd")"
                                               class="btn btn-sm btn-soft-primary">
                                                <i class="bx bx-file me-1"></i> Open file
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<permission required="@Permissions.BlockServices.ChangeStatus">
    <partial name="_BlockStatusModal" />
</permission>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            // Column indices are positional — adding a column means bumping these too. This table has
            // no "Bookings" column (always 1), so the indices differ from the blocks table by one.
            $('#singles-table').DataTable({ order: [[1, 'asc']], columnDefs: [{ orderable: false, targets: [4, 6] }] });
        });

        window.blockStatusConfig = {
            url: '@Url.Action("SetStatus")',
            token: $('input[name="__RequestVerificationToken"]').val()
        };
    </script>
    <script src="~/back/assets/js/block-status.js"></script>
}
