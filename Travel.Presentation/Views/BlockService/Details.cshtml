@model Travel.Presentation.ViewModels.BlockDetailsViewModel
@using Travel.Domain.Enums
@using Travel.Domain.Services.BlockServices
@using Microsoft.AspNetCore.Authorization
@using Travel.Presentation.Helpers
@inject IAuthorizationService AuthorizationService
@{
    var file = Model.File;
    var s = file.Summary;
    ViewData["Title"] = $"{s.DestinationName} {CategoryBadges.Short(s.Category)} — {s.CheckInDate:dd MMM yyyy}";

    var statusBadge = StatusBadges.ForBlock(s.Status.Status);

    // A user can hold BlockServices.View without Bookings.View — don't offer a link that 403s.
    var canOpenBooking = (await AuthorizationService.AuthorizeAsync(User, Permissions.Bookings.View)).Succeeded;

    string RoomAbbr(RoomType t) => t == RoomType.Single ? "SGL" : t == RoomType.Double ? "DBL" : "TRP";
    string Rooming(IReadOnlyList<RoomTally> rooms) =>
        rooms.Count == 0 ? "—" : string.Join(" · ", rooms.Select(r => $"{r.Quantity} × {RoomAbbr(r.Type)}"));
    string GuestTypeText(GuestType t) =>
        t == GuestType.Adult ? "Adult" : t == GuestType.Child ? "Child (6-12)" : "Infant (0-5)";

    // A one-booking group is a real file, not a block — same layout, honest wording.
    var isSingle = s.BookingCount == 1;

    var minOut = s.CheckInDate.AddDays(s.MinNights);
    var maxOut = s.CheckInDate.AddDays(s.MaxNights);
    var checkOutText = minOut == maxOut
        ? minOut.ToString("dd MMM yyyy")
        : $"{minOut:dd MMM yyyy} – {maxOut:dd MMM yyyy}";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card print-sheet">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-info-subtle text-info">
                                @if (s.IsCruise)
                                {
                                    <i class="bx bxs-ship me-1"></i>
                                    <text>Cruise</text>
                                }
                                else
                                {
                                    <i class="bx bx-buildings me-1"></i>
                                    <text>Hotel</text>
                                }
                                <text>@(isSingle ? "single arrival" : "block")</text>
                            </span>
                            <span class="badge @statusBadge.CssClass">
                                <i class="bx @statusBadge.Icon me-1"></i>@statusBadge.Label
                            </span>
                        </div>
                        @if (s.Status.Status == BlockStatus.NeedsAmendment)
                        {
                            @* Which document went out of date — the request we sent, or the reply we
                               got. Inline muted text, not a tooltip; this project doesn't use them. *@
                            <small class="text-danger d-block mb-1">
                                @(s.Status.StoredStatus == BlockStatus.InProgress
                                    ? "The booking request sent to the supplier no longer matches this group."
                                    : "The supplier's confirmation no longer matches this group.")
                            </small>
                        }
                        @* The category is part of the file's identity — the same destination and
                           date has a separate file for the other grade — so it sits in the heading,
                           and it prints: the hotel needs to know which grade it is blocking. *@
                        <h4 class="mb-1">
                            @s.DestinationName
                            <span class="@CategoryBadges.Css(s.Category) align-middle font-size-12 ms-1">@CategoryBadges.Label(s.Category)</span>
                        </h4>
                        <div class="text-muted">
                            Check-in <strong>@s.CheckInDate.ToString("dd MMM yyyy")</strong>
                            <span class="mx-1">→</span> Check-out <strong>@checkOutText</strong>
                        </div>
                        @if (s.Status.UpdatedAt is { } updatedAt)
                        {
                            @* Inline muted text, not a tooltip — this project doesn't use them. *@
                            <small class="text-muted d-block mt-1">
                                Status set @updatedAt.ToString("dd MMM yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(s.Status.UpdatedByName))
                                {
                                    <text>by @s.Status.UpdatedByName</text>
                                }
                            </small>
                        }
                    </div>
                    <div class="text-nowrap d-print-none">
                        <permission required="@Permissions.BlockServices.ChangeStatus">
                            <button type="button"
                                    class="btn btn-soft-secondary btn-sm js-block-status"
                                    data-destination-id="@s.DestinationId"
                                    data-destination-name="@s.DestinationName"
                                    data-check-in="@s.CheckInDate.ToString("yyyy-MM-dd")"
                                    data-check-in-text="@s.CheckInDate.ToString("dd MMM yyyy")"
                                    data-category="@((int)s.Category)"
                                    data-category-text="@CategoryBadges.Short(s.Category)"
                                    @* Stored, not displayed — see _BlockStatusCell. *@
                                    data-status="@((int)s.Status.StoredStatus)"
                                    data-request-link="@s.Status.RequestEmailLink"
                                    data-confirmation-link="@s.Status.ConfirmationEmailLink">
                                <i class="bx bx-edit-alt me-1"></i>Status
                            </button>
                        </permission>
                        <button type="button" class="btn btn-light btn-sm" onclick="window.print()">
                            <i class="bx bx-printer me-1"></i>Print
                        </button>
                        <permission required="@Permissions.BlockServices.Export">
                            <a asp-action="Export"
                               asp-route-destinationId="@s.DestinationId"
                               asp-route-checkIn="@s.CheckInDate.ToString("yyyy-MM-dd")"
                               asp-route-category="@s.Category"
                               class="btn btn-success btn-sm">
                                <i class="bx bx-spreadsheet me-1"></i>Excel
                            </a>
                        </permission>
                        @* Return to whichever list this file is actually listed in. *@
                        <a asp-action="@(isSingle ? "SingleArrivals" : "Index")" class="btn btn-light btn-sm">Back</a>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-3">
                        <h6 class="text-muted text-uppercase font-size-12">Bookings</h6>
                        <p class="mb-0 fw-semibold">@s.BookingCount</p>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted text-uppercase font-size-12">Total PAX</h6>
                        <p class="mb-0 fw-semibold">
                            @s.TotalPax
                            @{
                                var totalParts = new List<string> { $"{s.Adults} adult{(s.Adults == 1 ? "" : "s")}" };
                                if (s.Children > 0) totalParts.Add($"{s.Children} child{(s.Children == 1 ? "" : "ren")}");
                                if (s.Infants > 0) totalParts.Add($"{s.Infants} infant{(s.Infants == 1 ? "" : "s")}");
                            }
                        </p>
                        <small class="text-muted">@string.Join(", ", totalParts)</small>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted text-uppercase font-size-12">Rooms</h6>
                        <p class="mb-0 fw-semibold">@Rooming(s.Rooms)</p>
                        <small class="text-muted">@s.Rooms.Sum(r => r.Quantity) room@(s.Rooms.Sum(r => r.Quantity) == 1 ? "" : "s") in total</small>
                    </div>
                    <div class="col-md-3">
                        <h6 class="text-muted text-uppercase font-size-12">Nights</h6>
                        <p class="mb-0 fw-semibold">@(s.MinNights == s.MaxNights ? $"{s.MinNights}" : $"{s.MinNights}–{s.MaxNights}")</p>
                    </div>
                </div>

                @if (s.Status.HasLinks)
                {
                    @* d-print-none: the printed sheet goes to the supplier, and these are internal
                       references to the operator's own mailbox. Same reason they're kept out of the
                       Excel export. *@
                    <div class="row mb-4 d-print-none">
                        @if (!string.IsNullOrWhiteSpace(s.Status.RequestEmailLink))
                        {
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase font-size-12">Booking request email</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <a href="@s.Status.RequestEmailLink" target="_blank" rel="noopener"
                                       class="text-truncate">@s.Status.RequestEmailLink</a>
                                    <button type="button" class="btn btn-sm btn-light d-print-none js-copy-text"
                                            data-value="@s.Status.RequestEmailLink" title="Copy link">
                                        <i class="bx bx-copy"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(s.Status.ConfirmationEmailLink))
                        {
                            <div class="col-md-6">
                                <h6 class="text-muted text-uppercase font-size-12">Booking confirmation email</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <a href="@s.Status.ConfirmationEmailLink" target="_blank" rel="noopener"
                                       class="text-truncate">@s.Status.ConfirmationEmailLink</a>
                                    <button type="button" class="btn btn-sm btn-light d-print-none js-copy-text"
                                            data-value="@s.Status.ConfirmationEmailLink" title="Copy link">
                                        <i class="bx bx-copy"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @{
                    var canManageDocs = (await AuthorizationService.AuthorizeAsync(User, Permissions.BlockServices.ManageDocuments)).Succeeded;
                }
                @if (s.Status.HasDocuments || canManageDocs)
                {
                    @* d-print-none, and absent from the export: a domestic flight ticket is our
                       document. The sheet in this card goes to the hotel supplier — same
                       "is this ours, or theirs?" call that keeps the email links off it. *@
                    <div class="border rounded p-3 mb-4 d-print-none">
                        <h6 class="text-muted text-uppercase font-size-12 mb-2">
                            <i class="bx bxs-plane me-1"></i>Domestic flight documents
                        </h6>
                        <p class="text-muted font-size-12">
                            Uploaded once for this arrival — every booking below carries it, including any added later.
                        </p>

                        @if (s.Status.HasDocuments)
                        {
                            <ul class="list-unstyled mb-3">
                                @foreach (var doc in s.Status.Documents)
                                {
                                    <li class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-1">
                                        <a href="@doc.FileUrl" target="_blank" rel="noopener" class="text-truncate me-2">
                                            <i class="bx @(doc.IsPdf ? "bxs-file-pdf" : "bxs-file-image") me-1"></i>@doc.OriginalFileName
                                        </a>
                                        <span class="d-flex align-items-center gap-2 text-nowrap">
                                            <small class="text-muted">
                                                @doc.UploadedAt.ToString("dd MMM yyyy")
                                                @if (!string.IsNullOrWhiteSpace(doc.UploadedByName))
                                                {
                                                    <text>· @doc.UploadedByName</text>
                                                }
                                            </small>
                                            @if (canManageDocs)
                                            {
                                                <button type="button" class="btn btn-sm btn-light text-danger js-delete-document"
                                                        data-id="@doc.Id" data-name="@doc.OriginalFileName" title="Remove">
                                                    <i class="bx bx-trash"></i>
                                                </button>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-3">No domestic flight document yet.</p>
                        }

                        @if (canManageDocs)
                        {
                            <form asp-action="UploadDocuments" method="post" enctype="multipart/form-data"
                                  asp-route-destinationId="@s.DestinationId"
                                  asp-route-checkIn="@s.CheckInDate.ToString("yyyy-MM-dd")"
                                  asp-route-category="@s.Category">
                                <div class="dropzone attachment-dropzone dz-clickable" id="dropzone-BlockDocs">
                                    <div class="dz-message">
                                        <i class="bx bx-cloud-upload font-size-24 text-muted"></i>
                                        <div class="text-muted small">Drop files or click to upload</div>
                                        <div class="text-muted small">PDF, JPG or PNG — up to 10MB each</div>
                                    </div>
                                </div>
                                <input type="file" multiple name="files" id="input-BlockDocs" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                                <button type="submit" class="btn btn-primary btn-sm mt-2">
                                    <i class="bx bx-upload me-1"></i>Upload
                                </button>
                            </form>
                        }
                    </div>
                }

                @*
                    Screen-only, and absent from the .xlsx: the block file goes to the HOTEL SUPPLIER,
                    and what we paid is ours. Same "is this ours, or theirs?" call already made for the
                    email links and the missing-document flag.
                *@
                <permission required="@Permissions.Expenses.View">
                    <partial name="_BlockExpensesCard" model="Model" />
                </permission>

                @foreach (var b in file.Bookings)
                {
                    <div class="block-booking border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                            <div>
                                @if (canOpenBooking)
                                {
                                    <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.BookingId"
                                       target="_blank" rel="noopener"
                                       class="text-decoration-none" title="Open booking @b.Code">
                                        <span class="badge bg-primary-subtle text-primary font-monospace">@b.Code</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary font-monospace">@b.Code</span>
                                }
                                <span class="fw-semibold ms-1">@b.LeadGuestName</span>
                                @if (b.MissingDomesticFlightDoc)
                                {
                                    @* d-print-none: an internal document gap. The printed sheet goes to
                                       the supplier — same reasoning that keeps the email links off it. *@
                                    <span class="badge bg-danger-subtle text-danger ms-1 d-print-none">
                                        <i class="bx bx-error-circle me-1"></i>No domestic flight doc
                                    </span>
                                }
                                <div class="text-muted font-size-12 mt-1">@b.PackageName</div>
                            </div>
                            <div class="text-md-end">
                                <div class="fw-semibold">@Rooming(b.Rooms)</div>
                                <small class="text-muted">
                                    @b.Pax PAX · @b.Nights night@(b.Nights == 1 ? "" : "s") · out @b.CheckOutDate.ToString("dd MMM yyyy")
                                </small>
                                @if (canOpenBooking)
                                {
                                    <div class="mt-2 d-print-none">
                                        <a asp-controller="Booking" asp-action="Details" asp-route-id="@b.BookingId"
                                           target="_blank" rel="noopener"
                                           class="btn btn-sm btn-soft-primary">
                                            <i class="bx bx-show me-1"></i>Open booking
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row mb-2">
                            <div class="col-md-4">
                                <h6 class="text-muted text-uppercase font-size-12 mb-1">Hotel</h6>
                                <span>@(string.IsNullOrWhiteSpace(b.HotelName) ? "—" : b.HotelName)</span>
                            </div>
                            <div class="col-md-4">
                                <h6 class="text-muted text-uppercase font-size-12 mb-1"><i class="bx bxs-plane-land me-1"></i>Arrival flight</h6>
                                <span>@(string.IsNullOrWhiteSpace(b.ArrivalFlightNo) ? "—" : b.ArrivalFlightNo)</span>
                                @* Falls back to the package date, but only once some flight detail is known. *@
                                @if (b.FlightArrivalDate is not null || b.ArrivalTime is not null || !string.IsNullOrWhiteSpace(b.ArrivalFlightNo))
                                {
                                    <small class="text-muted d-block">
                                        @((b.FlightArrivalDate ?? b.ArrivalDate).ToString("dd MMM yyyy"))
                                        @if (b.ArrivalTime is not null)
                                        {
                                            <text>· @b.ArrivalTime.Value.ToString("HH:mm")</text>
                                        }
                                    </small>
                                }
                            </div>
                            <div class="col-md-4">
                                <h6 class="text-muted text-uppercase font-size-12 mb-1"><i class="bx bxs-plane-take-off me-1"></i>Departure flight</h6>
                                <span>@(string.IsNullOrWhiteSpace(b.DepartureFlightNo) ? "—" : b.DepartureFlightNo)</span>
                                @if (b.FlightDepartureDate is not null || b.DepartureTime is not null || !string.IsNullOrWhiteSpace(b.DepartureFlightNo))
                                {
                                    <small class="text-muted d-block">
                                        @((b.FlightDepartureDate ?? b.DepartureDate).ToString("dd MMM yyyy"))
                                        @if (b.DepartureTime is not null)
                                        {
                                            <text>· @b.DepartureTime.Value.ToString("HH:mm")</text>
                                        }
                                    </small>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(b.StayNotes))
                        {
                            <div class="mb-2">
                                <h6 class="text-muted text-uppercase font-size-12 mb-1">Stay notes</h6>
                                <span>@b.StayNotes</span>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th style="width:40px">#</th><th>Guest name</th><th>Type</th><th class="text-end">Age</th></tr>
                                </thead>
                                <tbody>
                                    @{ var g = 1; }
                                    @foreach (var guest in b.Guests)
                                    {
                                        <tr>
                                            <td>@g</td>
                                            <td>
                                                @guest.FullName
                                                @if (guest.IsLeadGuest)
                                                {
                                                    <span class="badge bg-success-subtle text-success ms-1">lead</span>
                                                }
                                            </td>
                                            <td>@GuestTypeText(guest.Type)</td>
                                            <td class="text-end">@(guest.Age?.ToString() ?? "—")</td>
                                        </tr>
                                        g++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center border-top pt-3 fw-semibold">
                    <span>TOTAL — @s.BookingCount booking@(isSingle ? "" : "s")</span>
                    <span>@s.TotalPax PAX · @Rooming(s.Rooms)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<permission required="@Permissions.BlockServices.ChangeStatus">
    <partial name="_BlockStatusModal" />
</permission>

@section Scripts {
    <script>
        window.blockStatusConfig = {
            url: '@Url.Action("SetStatus")',
            token: $('input[name="__RequestVerificationToken"]').val()
        };
    </script>
    <script src="~/back/assets/js/block-status.js"></script>
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/attachment-dropzones.js"></script>
    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

            $(document).on('click', '.js-delete-document', function () {
                var $btn = $(this);

                Swal.fire({
                    title: 'Remove this document?',
                    text: $btn.data('name') + ' — every booking in this arrival loses it.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f46a6a',
                    cancelButtonColor: '#74788d',
                    confirmButtonText: 'Yes, remove it'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('@Url.Action("DeleteDocument")', { id: $btn.data('id'), __RequestVerificationToken: token })
                        .done(function (res) {
                            if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                            else { toastr.error(res.message); }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });
        });
    </script>
}
