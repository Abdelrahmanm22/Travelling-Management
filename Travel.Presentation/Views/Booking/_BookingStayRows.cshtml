@using Travel.Presentation.Helpers
@using Travel.Presentation.Services
@model Travel.Presentation.ViewModels.BookingViewModel

@*
    Editable schedule — one row per stay block. booking-form.js reindexes names and recomputes check-in dates.

    Extra nights are DERIVED (Nights − BaselineNights), never typed: the schedule stays the single source
    of truth for how long the trip runs. BaselineNights rides along as a hidden field like IsOverridden.
    The pricing columns only render for a user with Bookings.EditPricing — a plain @if, not <permission>,
    because the rest of the row must render either way.

    🔴 The extra-night rates POST FROM THIS ROW, as hidden inputs in the cost cell. _BookingStayRatesModal
    is only an editor over copies of them. Two consequences:
      • the hidden inputs must stay inside the <td> — an <input> directly under a <tr> is foster-parented
        out of the table by the HTML parser and silently stops posting;
      • they are never `disabled`: MVC's collection binder stops at the first missing index, so a partial
        post yields an EMPTY rate list and the operator's figures vanish with no error.
    Every validation span also lives here rather than in the modal, so an error is visible without
    opening anything — a message inside a closed dialog is the invisible-rule bug this form has hit
    three times.
*@
<div class="table-responsive">
    <table class="table align-middle" id="stays-table">
        <thead class="table-light">
            <tr>
                <th style="width:40px">#</th>
                <th>Destination</th>
                <th style="width:140px">Check-in</th>
                <th style="width:90px">Nights</th>
                @if (Model.CanEditPricing)
                {
                    <th style="width:80px" class="text-center">Extra</th>
                    <th style="width:180px">Extra nights cost</th>
                }
                <th class="stay-col-hotel">Hotel</th>
                <th class="stay-col-notes">Notes</th>
                <th style="width:110px"></th>
            </tr>
        </thead>
        <tbody id="stays-container">
            @for (int i = 0; i < Model.Stays.Count; i++)
            {
                <tr class="stay-row">
                    <td class="stay-index">@(i + 1)</td>
                    <td>
                        <select name="Stays[@i].DestinationId" class="form-select form-select-sm stay-destination">
                            <option value="">— Select —</option>
                            @foreach (var opt in Model.StayDestinationOptions)
                            {
                                if (opt.Value == Model.Stays[i].DestinationId.ToString())
                                {
                                    <option value="@opt.Value" selected>@opt.Text</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        <input name="Stays[@i].CheckInDate" type="date" value="@Model.Stays[i].CheckInDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm stay-checkin" readonly />
                        <div class="small text-muted stay-checkout"></div>
                    </td>
                    <td>
                        <input name="Stays[@i].Nights" type="number" min="1" max="120" value="@Model.Stays[i].Nights" class="form-control form-control-sm stay-nights" />
                        <input type="hidden" name="Stays[@i].BaselineNights" value="@Model.Stays[i].BaselineNights" class="stay-baseline" />
                    </td>
                    @if (Model.CanEditPricing)
                    {
                        var extra = Model.Stays[i].ExtraNights;
                        var arranged = Model.Stays[i].ExtraNightsArrangedByGuest;
                        <td class="text-center">
                            <span class="badge @(extra > 0 ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary") stay-extra">@(extra > 0 ? $"+{extra}" : "—")</span>
                        </td>
                        <td class="stay-cost">
                            @* These triples ARE the posted rates — see the red note at the top of this file. *@
                            @for (int j = 0; j < Model.Stays[i].Rates.Count; j++)
                            {
                                <span class="stay-rate d-none">
                                    <input type="hidden" name="Stays[@i].Rates[@j].RoomType" value="@((int)Model.Stays[i].Rates[j].RoomType)" class="stay-rate-type" />
                                    <input type="hidden" name="Stays[@i].Rates[@j].Quantity" value="@Model.Stays[i].Rates[j].Quantity" class="stay-rate-qty" />
                                    <input type="hidden" name="Stays[@i].Rates[@j].Rate" value="@(Model.Stays[i].Rates[j].Rate?.ToString("0.##"))" class="stay-rate-amount" />
                                </span>
                            }
                            @* One hidden, not the checkbox+hidden pair: nothing here is clickable any
                               more, so the "binder takes the first of true,false" trap disappears. *@
                            <input type="hidden" name="Stays[@i].ExtraNightsArrangedByGuest" value="@arranged.ToString().ToLower()" class="stay-arranged" />

                            <button type="button" class="btn btn-sm btn-link p-0 text-start text-decoration-none stay-rates-btn"
                                    aria-haspopup="dialog" title="Room rates for the extra nights" disabled="@(extra == 0)">
                                <i class="bx bx-edit-alt me-1 stay-rates-icon"></i><span class="stay-extra-total"></span>
                            </button>
                            <span class="badge bg-info-subtle text-info stay-arranged-badge @(arranged ? "" : "d-none")">Guest-arranged</span>

                            @* Unconditional, and never inside the modal. ValidatePricing keys its errors
                               on exactly these paths; without a span the POST returns the form with no
                               visible reason, which also wipes any files picked in the dropzones. *@
                            <span asp-validation-for="Stays[i].Rates" class="text-danger small d-block"></span>
                            @for (int j = 0; j < Model.Stays[i].Rates.Count; j++)
                            {
                                <span asp-validation-for="Stays[i].Rates[j].Quantity" class="text-danger small d-block"></span>
                                <span asp-validation-for="Stays[i].Rates[j].Rate" class="text-danger small d-block"></span>
                            }
                            <div class="small text-muted mt-1 stay-rooms-warning d-none"></div>
                        </td>
                    }
                    @* Keep each textarea on one line — indentation before </textarea> posts as real whitespace. *@
                    <td class="stay-col-hotel">
                        <textarea name="Stays[@i].HotelName" class="form-control form-control-sm stay-grow" rows="1" maxlength="200" placeholder="optional">@Model.Stays[i].HotelName</textarea>
                    </td>
                    <td class="stay-col-notes">
                        <textarea name="Stays[@i].Notes" class="form-control form-control-sm stay-grow" rows="1" maxlength="1000" placeholder="optional">@Model.Stays[i].Notes</textarea>
                    </td>
                    <td class="text-nowrap">
                        <input type="hidden" name="Stays[@i].IsOverridden" value="@Model.Stays[i].IsOverridden.ToString().ToLower()" class="stay-overridden" />
                        <button type="button" class="btn btn-sm btn-light stay-up" title="Move up"><i class="bx bx-up-arrow-alt"></i></button>
                        <button type="button" class="btn btn-sm btn-light stay-down" title="Move down"><i class="bx bx-down-arrow-alt"></i></button>
                        <button type="button" class="btn btn-sm btn-soft-danger stay-remove" title="Remove"><i class="bx bx-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button type="button" class="btn btn-sm btn-soft-primary" id="add-stay"><i class="bx bx-plus me-1"></i> Add stay</button>

@*
    The template deliberately carries no asp-validation-for spans: a failed POST re-renders from
    Model.Stays through the @for loop above, never from here. The Rates indices are literal 0/1/2 and
    must NOT be __INDEX__ — only the stay index is reindexed, and recalc()'s replace has no /g flag
    precisely so the inner index survives.
*@
<template id="stay-row-template">
    <tr class="stay-row">
        <td class="stay-index"></td>
        <td>
            <select name="Stays[__INDEX__].DestinationId" class="form-select form-select-sm stay-destination">
                <option value="">— Select —</option>
                @foreach (var opt in Model.StayDestinationOptions)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </td>
        <td>
            <input name="Stays[__INDEX__].CheckInDate" type="date" class="form-control form-control-sm stay-checkin" readonly />
            <div class="small text-muted stay-checkout"></div>
        </td>
        <td>
            <input name="Stays[__INDEX__].Nights" type="number" min="1" max="120" value="1" class="form-control form-control-sm stay-nights" />
            @* A hand-added stay has no generated baseline, so every one of its nights is chargeable. *@
            <input type="hidden" name="Stays[__INDEX__].BaselineNights" value="0" class="stay-baseline" />
        </td>
        @if (Model.CanEditPricing)
        {
            <td class="text-center"><span class="badge bg-warning-subtle text-warning stay-extra">+1</span></td>
            <td class="stay-cost">
                @{ var types = Enum.GetValues<Travel.Domain.Enums.RoomType>().OrderBy(t => t).ToList(); }
                @for (int j = 0; j < types.Count; j++)
                {
                    <span class="stay-rate d-none">
                        <input type="hidden" name="Stays[__INDEX__].Rates[@j].RoomType" value="@((int)types[j])" class="stay-rate-type" />
                        <input type="hidden" name="Stays[__INDEX__].Rates[@j].Quantity" value="0" class="stay-rate-qty" />
                        <input type="hidden" name="Stays[__INDEX__].Rates[@j].Rate" value="" class="stay-rate-amount" />
                    </span>
                }
                <input type="hidden" name="Stays[__INDEX__].ExtraNightsArrangedByGuest" value="false" class="stay-arranged" />

                <button type="button" class="btn btn-sm btn-link p-0 text-start text-decoration-none stay-rates-btn"
                        aria-haspopup="dialog" title="Room rates for the extra nights">
                    <i class="bx bx-edit-alt me-1 stay-rates-icon"></i><span class="stay-extra-total"></span>
                </button>
                <span class="badge bg-info-subtle text-info stay-arranged-badge d-none">Guest-arranged</span>
                <div class="small text-muted mt-1 stay-rooms-warning d-none"></div>
            </td>
        }
        <td class="stay-col-hotel"><textarea name="Stays[__INDEX__].HotelName" class="form-control form-control-sm stay-grow" rows="1" maxlength="200" placeholder="optional"></textarea></td>
        <td class="stay-col-notes"><textarea name="Stays[__INDEX__].Notes" class="form-control form-control-sm stay-grow" rows="1" maxlength="1000" placeholder="optional"></textarea></td>
        <td class="text-nowrap">
            <input type="hidden" name="Stays[__INDEX__].IsOverridden" value="true" class="stay-overridden" />
            <button type="button" class="btn btn-sm btn-light stay-up" title="Move up"><i class="bx bx-up-arrow-alt"></i></button>
            <button type="button" class="btn btn-sm btn-light stay-down" title="Move down"><i class="bx bx-down-arrow-alt"></i></button>
            <button type="button" class="btn btn-sm btn-soft-danger stay-remove" title="Remove"><i class="bx bx-trash"></i></button>
        </td>
    </tr>
</template>
