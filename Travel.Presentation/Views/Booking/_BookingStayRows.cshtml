@using Travel.Presentation.Helpers
@model Travel.Presentation.ViewModels.BookingViewModel

@*
    Editable schedule — one row per stay block. booking-form.js reindexes names and recomputes check-in dates.

    Extra nights are DERIVED (Nights − BaselineNights), never typed: the schedule stays the single source
    of truth for how long the trip runs. BaselineNights rides along as a hidden field like IsOverridden.
    The rate column only renders for a user with Bookings.EditPricing — a plain @if, not <permission>,
    because the rest of the row must render either way.
*@
<div class="table-responsive">
    <table class="table align-middle" id="stays-table">
        <thead class="table-light">
            <tr>
                <th style="width:40px">#</th>
                <th>Destination</th>
                <th style="width:140px">Check-in</th>
                <th style="width:90px">Nights</th>
                @if (Model.CanEditPricing)
                {
                    <th style="width:80px" class="text-center">Extra</th>
                    <th style="width:150px">Price / night</th>
                }
                <th class="stay-col-hotel">Hotel</th>
                <th class="stay-col-notes">Notes</th>
                <th style="width:110px"></th>
            </tr>
        </thead>
        <tbody id="stays-container">
            @for (int i = 0; i < Model.Stays.Count; i++)
            {
                <tr class="stay-row">
                    <td class="stay-index">@(i + 1)</td>
                    <td>
                        <select name="Stays[@i].DestinationId" class="form-select form-select-sm stay-destination">
                            <option value="">— Select —</option>
                            @foreach (var opt in Model.StayDestinationOptions)
                            {
                                if (opt.Value == Model.Stays[i].DestinationId.ToString())
                                {
                                    <option value="@opt.Value" selected>@opt.Text</option>
                                }
                                else
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        <input name="Stays[@i].CheckInDate" type="date" value="@Model.Stays[i].CheckInDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm stay-checkin" readonly />
                        <div class="small text-muted stay-checkout"></div>
                    </td>
                    <td>
                        <input name="Stays[@i].Nights" type="number" min="1" max="120" value="@Model.Stays[i].Nights" class="form-control form-control-sm stay-nights" />
                        <input type="hidden" name="Stays[@i].BaselineNights" value="@Model.Stays[i].BaselineNights" class="stay-baseline" />
                    </td>
                    @if (Model.CanEditPricing)
                    {
                        var extra = Model.Stays[i].ExtraNights;
                        <td class="text-center">
                            <span class="badge @(extra > 0 ? "bg-warning-subtle text-warning" : "bg-secondary-subtle text-secondary") stay-extra">@(extra > 0 ? $"+{extra}" : "—")</span>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">@Money.Code</span>
                                <input name="Stays[@i].ExtraNightPrice" type="number" step="0.01" min="0" placeholder="0.00"
                                       value="@(Model.Stays[i].ExtraNightPrice?.ToString("0.##"))"
                                       class="form-control form-control-sm stay-extra-price" disabled="@(extra == 0)" />
                            </div>
                            @* Load-bearing: ValidatePricing keys its error on Stays[i].ExtraNightPrice, and
                               without a span the POST returns the form with no visible reason — the exact
                               2026-08-02 failure, which also wipes any files picked in the dropzones. *@
                            <span asp-validation-for="Stays[i].ExtraNightPrice" class="text-danger small"></span>
                            <div class="small text-muted mt-1 stay-extra-total">@(extra > 0 ? Money.Format(Model.Stays[i].ExtraNightsTotal) : "")</div>
                        </td>
                    }
                    @* Keep each textarea on one line — indentation before </textarea> posts as real whitespace. *@
                    <td class="stay-col-hotel">
                        <textarea name="Stays[@i].HotelName" class="form-control form-control-sm stay-grow" rows="1" maxlength="200" placeholder="optional">@Model.Stays[i].HotelName</textarea>
                    </td>
                    <td class="stay-col-notes">
                        <textarea name="Stays[@i].Notes" class="form-control form-control-sm stay-grow" rows="1" maxlength="1000" placeholder="optional">@Model.Stays[i].Notes</textarea>
                    </td>
                    <td class="text-nowrap">
                        <input type="hidden" name="Stays[@i].IsOverridden" value="@Model.Stays[i].IsOverridden.ToString().ToLower()" class="stay-overridden" />
                        <button type="button" class="btn btn-sm btn-light stay-up" title="Move up"><i class="bx bx-up-arrow-alt"></i></button>
                        <button type="button" class="btn btn-sm btn-light stay-down" title="Move down"><i class="bx bx-down-arrow-alt"></i></button>
                        <button type="button" class="btn btn-sm btn-soft-danger stay-remove" title="Remove"><i class="bx bx-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<button type="button" class="btn btn-sm btn-soft-primary" id="add-stay"><i class="bx bx-plus me-1"></i> Add stay</button>

<template id="stay-row-template">
    <tr class="stay-row">
        <td class="stay-index"></td>
        <td>
            <select name="Stays[__INDEX__].DestinationId" class="form-select form-select-sm stay-destination">
                <option value="">— Select —</option>
                @foreach (var opt in Model.StayDestinationOptions)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </td>
        <td>
            <input name="Stays[__INDEX__].CheckInDate" type="date" class="form-control form-control-sm stay-checkin" readonly />
            <div class="small text-muted stay-checkout"></div>
        </td>
        <td>
            <input name="Stays[__INDEX__].Nights" type="number" min="1" max="120" value="1" class="form-control form-control-sm stay-nights" />
            @* A hand-added stay has no generated baseline, so every one of its nights is chargeable. *@
            <input type="hidden" name="Stays[__INDEX__].BaselineNights" value="0" class="stay-baseline" />
        </td>
        @if (Model.CanEditPricing)
        {
            <td class="text-center"><span class="badge bg-warning-subtle text-warning stay-extra">+1</span></td>
            <td>
                <div class="input-group input-group-sm">
                    <span class="input-group-text">@Money.Code</span>
                    <input name="Stays[__INDEX__].ExtraNightPrice" type="number" step="0.01" min="0" placeholder="0.00" class="form-control form-control-sm stay-extra-price" />
                </div>
                <div class="small text-muted mt-1 stay-extra-total"></div>
            </td>
        }
        <td class="stay-col-hotel"><textarea name="Stays[__INDEX__].HotelName" class="form-control form-control-sm stay-grow" rows="1" maxlength="200" placeholder="optional"></textarea></td>
        <td class="stay-col-notes"><textarea name="Stays[__INDEX__].Notes" class="form-control form-control-sm stay-grow" rows="1" maxlength="1000" placeholder="optional"></textarea></td>
        <td class="text-nowrap">
            <input type="hidden" name="Stays[__INDEX__].IsOverridden" value="true" class="stay-overridden" />
            <button type="button" class="btn btn-sm btn-light stay-up" title="Move up"><i class="bx bx-up-arrow-alt"></i></button>
            <button type="button" class="btn btn-sm btn-light stay-down" title="Move down"><i class="bx bx-down-arrow-alt"></i></button>
            <button type="button" class="btn btn-sm btn-soft-danger stay-remove" title="Remove"><i class="bx bx-trash"></i></button>
        </td>
    </tr>
</template>
