@model Travel.Presentation.ViewModels.BookingViewModel
@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@{
    ViewData["Title"] = "New Booking";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />
<link href="~/back/assets/libs/bootstrap-timepicker/css/bootstrap-timepicker.min.css" rel="stylesheet" type="text/css" />

@* Same card order as Edit.cshtml — keep the two in step. Every card the section nav or the error
   panel names carries data-section; the nav's targets also carry id + .booking-section. *@
<form asp-action="Create" method="post" id="booking-form" class="booking-form" enctype="multipart/form-data"
      data-preview-url="@Url.Action("Preview")"
      data-fixed="@Model.PackageHasFixedTotal.ToString().ToLower()"
      data-total="@(Model.PackageTotalNights?.ToString() ?? "")"
      data-base="@(Model.PackageBaseDestinationId?.ToString() ?? "")"
      data-cruise="@Model.PackageHasCruise.ToString().ToLower()"
      data-extension-reason="@Model.ExtensionReason">
    <partial name="_BookingFormNav" model="Model" />
    <partial name="_BookingFormErrors" model="Model" />
    <input type="hidden" asp-for="IsManuallyEdited" id="isManuallyEdited" />

    <div class="card booking-section" id="section-package" data-section="Package">
        <div class="card-body">
            <h4 class="card-title mb-4">Booking &amp; package</h4>

            <div class="row">
                <div class="col-md-6 col-lg-4 mb-3">
                    <label asp-for="PackageId" class="form-label"></label>
                    <select asp-for="PackageId" asp-items="Model.PackageOptions" class="form-select">
                        <option value="">— Select package —</option>
                    </select>
                    <span asp-validation-for="PackageId" class="text-danger"></span>
                </div>
                <div class="col-md-6 col-lg-2 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<PackageCategory>()" class="form-select">
                        <option value="">— Select —</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-md-6 col-lg-3 mb-3">
                    <label asp-for="ArrivalDate" class="form-label"></label>
                    <input asp-for="ArrivalDate" type="date" class="form-control" id="arrivalDate" />
                    <small class="text-muted d-block">Actual package start date.</small>
                    <span asp-validation-for="ArrivalDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 col-lg-3 mb-3">
                    <label asp-for="DepartureDate" class="form-label"></label>
                    <input asp-for="DepartureDate" type="date" class="form-control" id="departureDate" />
                    <small class="text-muted d-block">Actual package end date.</small>
                    <span asp-validation-for="DepartureDate" class="text-danger"></span>
                    @* Separate element from the static hint above — syncDepartureMode() overwrites its textContent. *@
                    <small class="text-muted d-block" id="departureHint"></small>
                </div>
            </div>

            <partial name="_BookingEmbarkOptions" model="Model" />

            <div class="row">
                <div class="col-md-6"><partial name="_BookingPrivateSwitch" model="Model" /></div>
                <div class="col-md-6"><partial name="_BookingVisaSwitch" model="Model" /></div>
            </div>

            <div class="mb-0">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional"></textarea>
            </div>
        </div>
    </div>

    <div class="card booking-section" id="section-schedule" data-section="Schedule">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h4 class="card-title mb-0">Schedule</h4>
                <button type="button" class="btn btn-sm btn-soft-warning" id="rebuild-schedule-btn">
                    <i class="bx bx-revision me-1"></i> Rebuild from package
                </button>
            </div>

            <div id="extensionAlert" class="alert alert-warning d-none" role="alert"></div>
            <div id="previewError" class="alert alert-danger d-none" role="alert"></div>
            <div id="schedule-banner" class="alert d-none" role="alert"></div>
            <div id="previewEmpty" class="text-muted">Pick a package and arrival date — the schedule is generated here, and you can edit it afterwards.</div>

            <div id="previewWrap" class="d-none">
                <partial name="_BookingStayRows" model="Model" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card booking-section" id="section-guests" data-section="Guests">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0"><i class="bx bx-group me-1"></i> Guests</h4>
                        <div>
                            <span class="badge bg-primary-subtle text-primary fs-6" id="pax-total">@Model.TotalPax PAX</span>
                            @if (Model.CanEditPricing)
                            {
                                <span class="badge bg-success-subtle text-success fs-6 ms-1" id="pax-grand-total" data-currency="@Money.Code">@Money.Format(Model.GrandTotal)</span>
                            }
                        </div>
                    </div>

                    <partial name="_BookingPaxCounts" model="Model" />

                    <partial name="_BookingGuestRows" model="Model" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <partial name="_BookingContact" model="Model" />

            <div class="card" data-section="Rooms">
                <div class="card-body">
                    <h4 class="card-title mb-4"><i class="bx bx-bed me-1"></i> Rooms</h4>
                    <partial name="_BookingRoomRows" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_BookingFlights" model="Model" />

    <partial name="_BookingExtraTours" model="Model" />

    <partial name="_BookingFirstPayment" model="Model" />

    <partial name="_BookingAttachments" model="Model" />

    <partial name="_BookingFormBar" model="Model" />
</form>

@* Outside the form (its inputs carry no name and must never post, and Enter in a number box inside
   the form would submit the booking), and outside #previewWrap — a modal inside a d-none ancestor
   never appears. *@
@if (Model.CanEditPricing)
{
    <partial name="_BookingStayRatesModal" model="Model" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/libs/bootstrap-timepicker/js/bootstrap-timepicker.min.js"></script>
    <script src="~/back/assets/js/time-24h.js"></script>
    <script src="~/back/assets/js/booking-form.js"></script>
    <script src="~/back/assets/js/attachment-dropzones.js"></script>
}
