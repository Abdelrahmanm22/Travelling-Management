@model Travel.Presentation.ViewModels.BookingViewModel
@using Travel.Domain.Enums
@{
    ViewData["Title"] = "Edit Booking";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<form asp-action="Edit" method="post" id="booking-edit-form" enctype="multipart/form-data"
      data-preview-url="@Url.Action("Preview")"
      data-fixed="@Model.PackageHasFixedTotal.ToString().ToLower()"
      data-total="@(Model.PackageTotalNights?.ToString() ?? "")"
      data-base="@(Model.PackageBaseDestinationId?.ToString() ?? "")"
      data-cruise="@Model.PackageHasCruise.ToString().ToLower()"
      data-extension-reason="@Model.ExtensionReason">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsManuallyEdited" id="isManuallyEdited" />

    <div class="row">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0">Booking &amp; package</h4>
                        @* Read-only: the code is issued once on create and the VM→entity map ignores it. *@
                        <span class="badge bg-primary-subtle text-primary font-monospace">@Model.Code</span>
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="PackageId" class="form-label"></label>
                            <select asp-for="PackageId" asp-items="Model.PackageOptions" class="form-select"></select>
                            <span asp-validation-for="PackageId" class="text-danger"></span>
                            <small class="text-muted">Changing the package rebuilds the schedule below — review it before saving.</small>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" asp-items="Html.GetEnumSelectList<PackageCategory>()" class="form-select">
                                <option value="">— Select —</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ArrivalDate" class="form-label"></label>
                            <input asp-for="ArrivalDate" type="date" class="form-control" id="arrivalDate" />
                            <small class="text-muted d-block">Actual package start date.</small>
                            <span asp-validation-for="ArrivalDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartureDate" class="form-label"></label>
                            <input asp-for="DepartureDate" type="date" class="form-control" id="departureDate" readonly />
                            <small class="text-muted d-block">Actual package end date.</small>
                            @* Separate element from the static hint above — syncDepartureMode() overwrites its textContent. *@
                            <small class="text-muted d-block" id="departureHint">Derived from the schedule.</small>
                            <span asp-validation-for="DepartureDate" class="text-danger"></span>
                        </div>
                    </div>

                    <partial name="_BookingEmbarkOptions" model="Model" />

                    <div class="mb-0">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="card-title mb-0">Schedule</h4>
                        <permission required="@Permissions.Bookings.Regenerate">
                            <button type="button" class="btn btn-sm btn-soft-warning" id="regenerate-btn"><i class="bx bx-revision me-1"></i> Regenerate</button>
                        </permission>
                    </div>

                    @* Filled by updateExtension() from the live row count — a server-rendered @if block
                       couldn't appear when the stored value was 0, nor update as the schedule changes. *@
                    <div id="extensionAlert" class="alert alert-warning d-none" role="alert"></div>
                    <div id="previewError" class="alert alert-danger d-none" role="alert"></div>
                    <div id="schedule-banner" class="alert d-none" role="alert"></div>

                    <partial name="_BookingStayRows" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4"><i class="bx bxs-plane-alt me-1"></i> Flights</h4>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="ArrivalFlightNo" class="form-label"></label>
                            <input asp-for="ArrivalFlightNo" class="form-control" placeholder="e.g. MS 985" />
                            <span asp-validation-for="ArrivalFlightNo" class="text-danger"></span>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label asp-for="ArrivalTime" class="form-label"></label>
                            <input asp-for="ArrivalTime" type="time" class="form-control" />
                            <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label asp-for="FlightArrivalDate" class="form-label"></label>
                            <input asp-for="FlightArrivalDate" type="date" class="form-control" id="flightArrivalDate" />
                            <span asp-validation-for="FlightArrivalDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label asp-for="DepartureFlightNo" class="form-label"></label>
                            <input asp-for="DepartureFlightNo" class="form-control" placeholder="e.g. MS 986" />
                            <span asp-validation-for="DepartureFlightNo" class="text-danger"></span>
                        </div>
                        <div class="col-md-5 mb-3">
                            <label asp-for="DepartureTime" class="form-label"></label>
                            <input asp-for="DepartureTime" type="time" class="form-control" />
                            <span asp-validation-for="DepartureTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-12 mb-0">
                            <label asp-for="FlightDepartureDate" class="form-label"></label>
                            <input asp-for="FlightDepartureDate" type="date" class="form-control" id="flightDepartureDate" />
                            <span asp-validation-for="FlightDepartureDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4"><i class="bx bx-user-voice me-1"></i> Contact</h4>

                    <div class="mb-3">
                        <label asp-for="GuestEmail" class="form-label"></label>
                        <input asp-for="GuestEmail" class="form-control" />
                        <span asp-validation-for="GuestEmail" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-0">
                            <label asp-for="GuestPhone" class="form-label"></label>
                            <input asp-for="GuestPhone" class="form-control" />
                            <span asp-validation-for="GuestPhone" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-0">
                            <label asp-for="NationalityId" class="form-label"></label>
                            <select asp-for="NationalityId" asp-items="Model.NationalityOptions" class="form-select">
                                <option value="">— Select nationality —</option>
                            </select>
                            <span asp-validation-for="NationalityId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0"><i class="bx bx-group me-1"></i> Guests</h4>
                        <span class="badge bg-primary-subtle text-primary fs-6" id="pax-total">@Model.TotalPax PAX</span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Adults" class="form-label"></label>
                            <input asp-for="Adults" type="number" min="1" max="50" class="form-control pax-count" data-guest-type="Adult" />
                            <span asp-validation-for="Adults" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Children" class="form-label"></label>
                            <input asp-for="Children" type="number" min="0" max="50" class="form-control pax-count" data-guest-type="Child" />
                            <span asp-validation-for="Children" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Infants" class="form-label"></label>
                            <input asp-for="Infants" type="number" min="0" max="50" class="form-control pax-count" data-guest-type="Infant" />
                            <span asp-validation-for="Infants" class="text-danger"></span>
                        </div>
                    </div>

                    <partial name="_BookingGuestRows" model="Model" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4"><i class="bx bx-bed me-1"></i> Rooms</h4>
                    <partial name="_BookingRoomRows" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <partial name="_BookingAttachments" model="Model" />

    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-light">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

@* Hidden regenerate form — posted after SweetAlert2 confirm. *@
<form asp-action="Regenerate" asp-route-id="@Model.Id" method="post" id="regenerate-form" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/booking-form.js"></script>
    <script src="~/back/assets/js/booking-attachments.js"></script>
}
