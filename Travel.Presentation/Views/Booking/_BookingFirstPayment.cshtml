@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@model Travel.Presentation.ViewModels.BookingViewModel

@*
    Create only. The first installment is taken as the booking is written, so the operator can't file
    a booking nobody has paid a deposit on.

    Rendered only for a user who can record payments — someone without Transactions.Create must still
    be able to create a booking, so the rule is skipped for them server-side too (ValidateFirstPayment).
    The same goes for pricing: no total means no 10% to enforce.

    Every field carries an asp-validation-for span. Without one a server-side error has no rendering
    surface and the POST silently returns the form with no visible reason (the 2026-08-02 bug).
*@
@if (Model.CanCreateTransactions)
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0"><i class="bx bx-wallet me-1"></i> First payment</h4>
                <span class="text-muted small">
                    Minimum (10% of the total):
                    <span class="badge bg-warning-subtle text-warning" id="first-payment-min" data-min="">—</span>
                </span>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="FirstPaymentAmount" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">@Money.Code</span>
                        <input asp-for="FirstPaymentAmount" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" id="first-payment-amount" />
                    </div>
                    <span asp-validation-for="FirstPaymentAmount" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="FirstPaymentMethod" class="form-label"></label>
                    <select asp-for="FirstPaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    <span asp-validation-for="FirstPaymentMethod" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="FirstPaymentDate" class="form-label"></label>
                    <input asp-for="FirstPaymentDate" type="date" class="form-control" />
                    <span asp-validation-for="FirstPaymentDate" class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="FirstPaymentReference" class="form-label"></label>
                    <input asp-for="FirstPaymentReference" class="form-control" placeholder="optional" />
                    <span asp-validation-for="FirstPaymentReference" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="FirstPaymentNotes" class="form-label"></label>
                <textarea asp-for="FirstPaymentNotes" class="form-control" rows="2" maxlength="1000" placeholder="optional"></textarea>
                <span asp-validation-for="FirstPaymentNotes" class="text-danger"></span>
            </div>

            @* Reuses attachment-dropzones.js verbatim — it pairs #dropzone-{key} with #input-{key}
               and knows nothing about bookings or transactions. Third use of the same script.
               Capped at one file, like every other receipt; the server re-checks. *@
            <label class="form-label">Receipt</label>
            <div class="dropzone attachment-dropzone" id="dropzone-firstpayment" data-key="firstpayment" data-max-files="1"></div>
            <input type="file" name="FirstPaymentFiles" id="input-firstpayment" class="d-none" />
            <span asp-validation-for="FirstPaymentFiles" class="text-danger"></span>
            <small class="text-muted">One PDF or image, up to @(AttachmentRules.MaxFileBytes / (1024 * 1024))MB.</small>
        </div>
    </div>
}
