@model Travel.Presentation.ViewModels.BookingViewModel
@using Travel.Domain.Enums

@{
    @* Domestic flight documents deliberately aren't here — they belong to the arrival group and are
       uploaded on BlockService/Details, so one file covers everyone flying that day. *@
    var categories = new[]
    {
        (Key: "Flight", Label: "Flights", Field: "FlightFiles", Category: AttachmentCategory.Flight),
        (Key: "Passport", Label: "Passports", Field: "PassportFiles", Category: AttachmentCategory.Passport),
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4"><i class="bx bx-paperclip me-1"></i> Attachments</h4>

                <div class="row">
                    @foreach (var c in categories)
                    {
                        var existing = Model.ExistingAttachments.Where(a => a.Category == c.Category).ToList();
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@c.Label</label>

                            @if (existing.Count > 0)
                            {
                                <ul class="list-unstyled mb-2 attachment-existing-list">
                                    @foreach (var a in existing)
                                    {
                                        var isPdf = a.FileUrl != null && a.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                        <li class="d-flex align-items-center justify-content-between border rounded px-2 py-1 mb-1">
                                            <a href="@a.FileUrl" target="_blank" class="text-truncate me-2" title="@a.OriginalFileName">
                                                <i class="bx @(isPdf ? "bxs-file-pdf" : "bxs-file-image") me-1"></i>@a.OriginalFileName
                                            </a>
                                            <label class="d-inline-flex align-items-center mb-0 text-danger" title="Remove on save">
                                                <input type="checkbox" class="form-check-input attachment-remove-check" name="RemoveAttachmentIds" value="@a.Id" />
                                                <i class="bx bx-trash ms-1"></i>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="dropzone attachment-dropzone dz-clickable" id="dropzone-@c.Key">
                                <div class="dz-message">
                                    <i class="bx bx-cloud-upload font-size-24 text-muted"></i>
                                    <div class="text-muted small">Drop files or click to upload</div>
                                    <div class="text-muted small">PDF, JPG or PNG — up to 10MB each</div>
                                </div>
                            </div>
                            <input type="file" multiple name="@c.Field" id="input-@c.Key" class="d-none" accept=".pdf,.jpg,.jpeg,.png" />
                            @Html.ValidationMessage(c.Field, new { @class = "text-danger d-block small mt-1" })
                        </div>
                    }
                </div>

                <div class="mb-0">
                    <label asp-for="ContractLink" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bx bx-link"></i></span>
                        <input asp-for="ContractLink" type="url" class="form-control" placeholder="https://..." />
                    </div>
                    <span asp-validation-for="ContractLink" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>
</div>
