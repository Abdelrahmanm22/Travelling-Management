@model BookingDetailsViewModel
@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@using Travel.Presentation.Services
@{
    var booking = Model.Booking;
    var statusBadge = StatusBadges.ForBooking(booking.Status);

    ViewData["Title"] = $"{booking.Code} — {booking.LeadGuestName}";
    var categoryText = CategoryBadges.Short(booking.Category);
    var rooming = booking.Rooms.OrderBy(r => r.SortOrder)
        .Select(r => $"{r.Quantity} × {(r.Type == RoomType.Single ? "SGL" : r.Type == RoomType.Double ? "DBL" : "TRP")}")
        .ToList();

    var paxParts = new List<string> { $"{booking.Adults} adult{(booking.Adults == 1 ? "" : "s")}" };
    if (booking.Children > 0) paxParts.Add($"{booking.Children} child{(booking.Children == 1 ? "" : "ren")}");
    if (booking.Infants > 0) paxParts.Add($"{booking.Infants} infant{(booking.Infants == 1 ? "" : "s")}");

    @* Domestic flight documents belong to the arrival group, not the booking — they're listed from
       Model.Blocks under the schedule instead. *@
    var attachmentGroups = new[]
    {
        (Label: "Flights", Category: AttachmentCategory.Flight, Icon: "bxs-plane-alt"),
        (Label: "Passports", Category: AttachmentCategory.Passport, Icon: "bx-id-card"),
    };
    var contract = booking.Attachments.FirstOrDefault(a => a.Category == AttachmentCategory.Contract);
    var documentedBlocks = Model.Blocks.Where(b => b.Status.HasDocuments).ToList();
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card print-sheet">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary font-monospace">@booking.Code</span>
                            <span class="badge @statusBadge.CssClass">
                                <i class="bx @statusBadge.Icon me-1"></i>@statusBadge.Label
                            </span>
                        </div>
                        <h4 class="mb-1">
                            @booking.LeadGuestName
                            <span class="badge bg-warning-subtle text-warning align-middle ms-1">@categoryText</span>
                            @if (booking.IsPrivate)
                            {
                                <span class="@CategoryBadges.PrivateCss align-middle ms-1"><i class="bx bx-lock-alt me-1"></i>Private</span>
                            }
                        </h4>
                        <div class="text-muted">
                            @booking.Package?.Name · @booking.Pax PAX
                            <span class="ms-1">(@string.Join(", ", paxParts))</span>
                        </div>
                    </div>
                    <div class="text-nowrap d-print-none">
                        <permission required="@Permissions.Bookings.ChangeStatus">
                            <partial name="_BookingStatusActions" model="booking" />
                        </permission>
                        <button type="button" class="btn btn-light btn-sm" onclick="window.print()">
                            <i class="bx bx-printer me-1"></i>Print
                        </button>
                        <permission required="@Permissions.Bookings.Export">
                            <a asp-action="Export" asp-route-id="@booking.Id" class="btn btn-success btn-sm">
                                <i class="bx bx-spreadsheet me-1"></i>Excel
                            </a>
                        </permission>
                        <permission required="@Permissions.Bookings.Edit">
                            <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-primary btn-sm"><i class="bx bx-pencil me-1"></i>Edit</a>
                        </permission>
                        <a asp-action="Index" class="btn btn-light btn-sm">Back</a>
                    </div>
                </div>

                @if (booking.ExtraNights > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bx bx-error-circle me-1"></i>
                        This booking includes @booking.ExtraNights extra night@(booking.ExtraNights > 1 ? "s" : "") beyond the package total.
                        @booking.ExtensionReason
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Arrival</h6><p class="mb-0 fw-semibold">@booking.ArrivalDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Departure</h6><p class="mb-0 fw-semibold">@booking.DepartureDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Email / Phone</h6><p class="mb-0">@booking.GuestEmail<br />@booking.GuestPhone</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Nationality</h6><p class="mb-0">@(booking.Nationality?.Name ?? "—")</p></div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bxs-plane-land me-1"></i>Arrival flight</h6>
                        <p class="mb-0 fw-semibold">@(string.IsNullOrWhiteSpace(booking.ArrivalFlightNo) ? "—" : booking.ArrivalFlightNo)</p>
                        <p class="mb-0 text-muted">
                            Flight: @(booking.FlightArrivalDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (booking.ArrivalTime is not null)
                            {
                                <text>· @booking.ArrivalTime.Value.ToString("HH:mm")</text>
                            }
                        </p>
                        <p class="mb-0 text-muted">Package: @booking.ArrivalDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bxs-plane-take-off me-1"></i>Departure flight</h6>
                        <p class="mb-0 fw-semibold">@(string.IsNullOrWhiteSpace(booking.DepartureFlightNo) ? "—" : booking.DepartureFlightNo)</p>
                        <p class="mb-0 text-muted">
                            Flight: @(booking.FlightDepartureDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (booking.DepartureTime is not null)
                            {
                                <text>· @booking.DepartureTime.Value.ToString("HH:mm")</text>
                            }
                        </p>
                        <p class="mb-0 text-muted">Package: @booking.DepartureDate.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-8">
                        <h5 class="mb-3">Guests</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>#</th><th>Name</th><th>Type</th><th class="text-end">Age</th></tr>
                                </thead>
                                <tbody>
                                    @{ var g = 1; }
                                    @foreach (var guest in booking.Guests.OrderBy(x => x.SortOrder))
                                    {
                                        <tr>
                                            <td>@g</td>
                                            <td>
                                                @guest.FullName
                                                @if (guest.IsLeadGuest)
                                                {
                                                    <span class="badge bg-success-subtle text-success ms-1">lead</span>
                                                }
                                            </td>
                                            <td>@(guest.Type == GuestType.Adult ? "Adult" : guest.Type == GuestType.Child ? "Child (6-12)" : "Infant (0-5)")</td>
                                            <td class="text-end">@(guest.Age?.ToString() ?? "—")</td>
                                        </tr>
                                        g++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h5 class="mb-3">Rooms</h5>
                        <p class="mb-0 fw-semibold">@(rooming.Count > 0 ? string.Join(" · ", rooming) : "—")</p>
                        <small class="text-muted">@booking.Rooms.Sum(r => r.Quantity) room@(booking.Rooms.Sum(r => r.Quantity) == 1 ? "" : "s") in total</small>
                    </div>
                </div>

                @* Gated on Bookings.ViewPricing. Deliberately NOT d-print-none: a printed booking sheet
                   goes to the operator or the client, never the hotel supplier — the block file is the
                   one that must stay free of our sale prices. *@
                @if (Model.CanViewPricing)
                {
                    <h5 class="mb-3">Pricing</h5>
                    @if (!booking.IsPriced)
                    {
                        @* An unpriced booking has no total anywhere — say which half is missing, since
                           extra-night rates are the half nobody expects after the pricing model changed. *@
                        <p class="text-muted mb-2"><i class="bx bx-dollar-circle me-1"></i> Not priced yet.</p>
                        @if (booking.HasUnpricedExtraNights)
                        {
                            var unpriced = booking.Stays
                                .Where(s => !s.ExtraNightsArePriced)
                                .OrderBy(s => s.SortOrder)
                                .Select(s => $"{s.Destination?.Name ?? "—"} (+{s.ExtraNights})");
                            <div class="alert alert-warning mb-4" role="alert">
                                <i class="bx bx-error-circle me-1"></i>
                                Extra nights with no room rates: <strong>@string.Join(", ", unpriced)</strong>.
                                Edit the booking to enter the rooms and rate per night, or mark them as arranged by the guest.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="table-responsive mb-4">
                            <table class="table align-middle mb-0" style="max-width:520px">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th class="text-end">Count</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (label, count, price) in new[]
                                    {
                                        ("Adults", booking.Adults, booking.AdultPrice),
                                        ("Children", booking.Children, booking.ChildPrice),
                                        ("Infants", booking.Infants, booking.InfantPrice),
                                    })
                                    {
                                        if (count == 0)
                                        {
                                            continue;
                                        }
                                        <tr>
                                            <td>@label</td>
                                            <td class="text-end">@count</td>
                                            <td class="text-end">@Money.Format(price)</td>
                                            <td class="text-end">@Money.Format(count * (price ?? 0m))</td>
                                        </tr>
                                    }
                                    @* One row per room type, so the figures reconcile back to what the
                                       hotel quoted. A guest-arranged stay still gets a 0.00 line rather
                                       than vanishing: a line that isn't there can't be queried. *@
                                    @foreach (var stay in booking.Stays.Where(s => s.ExtraNights > 0).OrderBy(s => s.SortOrder))
                                    {
                                        if (stay.ExtraNightsArrangedByGuest)
                                        {
                                            <tr>
                                                <td>
                                                    Extra nights <span class="text-muted">— @stay.Destination?.Name</span>
                                                    <span class="badge bg-info-subtle text-info ms-1">Guest-arranged</span>
                                                </td>
                                                <td class="text-end">@stay.ExtraNights</td>
                                                <td class="text-end">—</td>
                                                <td class="text-end">@Money.Format(0m)</td>
                                            </tr>
                                            continue;
                                        }

                                        foreach (var rate in stay.Rates.Where(r => r.Quantity > 0).OrderBy(r => r.RoomType))
                                        {
                                            <tr>
                                                <td>
                                                    Extra nights <span class="text-muted">— @stay.Destination?.Name</span>
                                                    <span class="badge bg-light text-body ms-1">@ExcelFormat.RoomTypeText(rate.RoomType) × @rate.Quantity</span>
                                                </td>
                                                <td class="text-end">@stay.ExtraNights</td>
                                                <td class="text-end">@Money.Format(rate.Rate)</td>
                                                <td class="text-end">@Money.Format(stay.ExtraNights * rate.Quantity * rate.Rate)</td>
                                            </tr>
                                        }
                                    }
                                    @foreach (var tour in booking.Tours.OrderBy(t => t.SortOrder))
                                    {
                                        <tr>
                                            <td>
                                                Tour <span class="text-muted">— @tour.Tour?.Name</span>
                                                @* A tour saved before names were recorded keeps its number until next edited. *@
                                                <div class="small text-muted">
                                                    @if (tour.HasNamedGuests)
                                                    {
                                                        <i class="bx bx-user"></i> @string.Join(", ", tour.Guests.Select(g => g.Guest).OrderBy(g => g.SortOrder).Select(g => g.FullName))
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning"><i class="bx bx-error-circle"></i> Names not recorded</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-end">@tour.Pax</td>
                                            <td class="text-end">@Money.Format(tour.UnitPrice)</td>
                                            <td class="text-end">@Money.Format(tour.Total)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="border-top">
                                    <tr class="fw-semibold">
                                        <td colspan="3">Total</td>
                                        <td class="text-end">@Money.Format(booking.GrandTotal)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Schedule</h5>
                    @if (booking.Status is BookingStatus.InProgress or BookingStatus.Confirmed && Model.Blocks.Count > 0)
                    {
                        @* Inline, not a tooltip — spells out the rule the Status badge above is obeying.
                           Counts blocks whose confirmation still covers THIS booking: a block can need
                           amending because a different booking changed, without un-confirming this one. *@
                        <small class="text-muted">
                            @{
                                var confirmed = Model.Blocks.Count(x => x.IsCovered);
                            }
                            @confirmed of @Model.Blocks.Count block@(Model.Blocks.Count == 1 ? "" : "s") confirmed
                        </small>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr><th>#</th><th>Stay</th><th>Check-in</th><th>Check-out</th><th class="text-end">Nights</th><th>Hotel</th><th>Block status</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @{ var i = 1; }
                            @foreach (var s in booking.Stays.OrderBy(x => x.SortOrder))
                            {
                                @* Each stay is one arrival group; the booking is confirmed only when all of them are.
                                   Every line here carries this booking's own category, so destination + date
                                   is enough to pick the right one. *@
                                var block = Model.Blocks.FirstOrDefault(x =>
                                    x.DestinationId == s.DestinationId && x.CheckInDate == s.CheckInDate);
                                var blockBadge = StatusBadges.ForBlock(block?.Status.Status ?? BlockStatus.NotBooked);

                                <tr>
                                    <td>@i</td>
                                    <td>
                                        @if (s.IsCruise)
                                        {
                                            <i class="bx bxs-ship me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bx bx-buildings me-1"></i>
                                        }
                                        @s.Destination?.Name
                                        @if (s.IsOverridden)
                                        {
                                            <span class="badge bg-info-subtle text-info ms-1">edited</span>
                                        }
                                        @* Not d-print-none: the nights ARE part of the package and appear
                                           on the booking document — who paid for them belongs there too. *@
                                        @if (s.ExtraNightsArrangedByGuest)
                                        {
                                            <span class="badge bg-info-subtle text-info ms-1" title="Extra nights booked by the guest, not through us">
                                                <i class="bx bx-user-check me-1"></i>@s.ExtraNights guest-arranged
                                            </span>
                                        }
                                    </td>
                                    <td>@s.CheckInDate.ToString("dd MMM yyyy")</td>
                                    <td>@s.CheckInDate.AddDays(s.Nights).ToString("dd MMM yyyy")</td>
                                    <td class="text-end">@s.Nights</td>
                                    <td>@(s.HotelName ?? "—")</td>
                                    <td class="text-nowrap">
                                        <span class="badge @blockBadge.CssClass">
                                            <i class="bx @blockBadge.Icon me-1"></i>@blockBadge.Label
                                        </span>
                                        @if (block?.Status.Status == BlockStatus.NeedsAmendment)
                                        {
                                            @* Whose amendment is it? Inline muted text, not a tooltip.
                                               An In-progress group covers nothing — it recorded a
                                               request, not a confirmation — so the covered wording
                                               would always read "not covered" and mean the wrong thing. *@
                                            <small class="text-muted d-block">
                                                @(block.Status.StoredStatus == BlockStatus.Confirmed
                                                    ? (block.IsCovered ? "this booking is still covered" : "this booking is not covered")
                                                    : "the request sent to the supplier is out of date")
                                            </small>
                                        }
                                        <permission required="@Permissions.BlockServices.View">
                                            <a asp-controller="BlockService" asp-action="Details"
                                               asp-route-destinationId="@s.DestinationId"
                                               asp-route-checkIn="@s.CheckInDate.ToString("yyyy-MM-dd")"
                                               asp-route-category="@booking.Category"
                                               asp-route-privateBookingId="@(booking.IsPrivate ? booking.Id : (int?)null)"
                                               target="_blank" rel="noopener"
                                               class="ms-1 d-print-none" title="Open block file">
                                                <i class="bx bx-link-external"></i>
                                            </a>
                                        </permission>
                                    </td>
                                    <td>@(s.Notes ?? "—")</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (documentedBlocks.Count > 0)
                {
                    @* Owned by the arrival group, not by this booking — read-only here, managed on the
                       block page. Listed per group because a trip can have a domestic leg per leg. *@
                    <h5 class="mt-4 mb-3"><i class="bx bxs-plane me-1"></i>Domestic flight documents</h5>
                    <div class="row">
                        @foreach (var b in documentedBlocks)
                        {
                            <div class="col-md-4 mb-3">
                                <h6 class="text-muted text-uppercase font-size-12">
                                    @CategoryBadges.GroupLabel(b.DestinationName, b.Category, b.CheckInDate)
                                </h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var doc in b.Status.Documents)
                                    {
                                        <li>
                                            <a href="@doc.FileUrl" target="_blank" rel="noopener">
                                                <i class="bx @(doc.IsPdf ? "bxs-file-pdf" : "bxs-file-image") me-1"></i>@doc.OriginalFileName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(booking.Notes))
                {
                    <h6 class="text-muted text-uppercase font-size-12 mt-3">Notes</h6>
                    <p class="mb-0">@booking.Notes</p>
                }

                @if (booking.Attachments.Any())
                {
                    <h5 class="mt-4 mb-3">Attachments</h5>
                    <div class="row">
                        @foreach (var group in attachmentGroups)
                        {
                            var files = booking.Attachments.Where(a => a.Category == group.Category).ToList();
                            if (files.Count == 0)
                                continue;

                            <div class="col-md-4 mb-3">
                                <h6 class="text-muted text-uppercase font-size-12"><i class="bx @group.Icon me-1"></i>@group.Label</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var a in files)
                                    {
                                        var isPdf = a.FileUrl != null && a.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                        <li>
                                            <a href="@a.FileUrl" target="_blank">
                                                <i class="bx @(isPdf ? "bxs-file-pdf" : "bxs-file-image") me-1"></i>@a.OriginalFileName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (contract is not null)
                        {
                            <div class="col-md-4 mb-3">
                                <h6 class="text-muted text-uppercase font-size-12"><i class="bx bx-link me-1"></i>Contract</h6>
                                <a href="@contract.LinkUrl" target="_blank"><i class="bx bx-link-external me-1"></i>Open contract</a>
                            </div>
                        }
                    </div>
                }

                @if (Model.CanViewTransactions)
                {
                    <hr class="my-4" />
                    <partial name="_BookingTransactions" model="Model" />
                }

                @if (Model.CanViewAudit)
                {
                    <hr class="my-4 d-print-none" />
                    <partial name="_BookingAuditTrail" model="Model" />
                }
            </div>
        </div>
    </div>
</div>

@* The token and handler are harmless without the permission — the buttons simply aren't rendered. *@
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        $(function () {
            var token = $('input[name="__RequestVerificationToken"]').val();

                $(document).on('click', '.js-booking-status', function () {
                    var $btn = $(this);
                    var status = $btn.data('status');

                    Swal.fire({
                        title: $btn.data('title'),
                        text: $btn.data('code') + ' — ' + $btn.data('text'),
                        icon: $btn.data('danger') ? 'warning' : 'question',
                        showCancelButton: true,
                        confirmButtonColor: $btn.data('danger') ? '#f46a6a' : '#556ee6',
                        cancelButtonColor: '#74788d',
                        confirmButtonText: 'Yes, continue'
                    }).then(function (result) {
                        if (!result.isConfirmed) return;
                        // An empty status means "reactivate" — the server recomputes it from the blocks.
                        var data = { id: $btn.data('id'), __RequestVerificationToken: token };
                        if (status !== '' && status !== undefined) data.status = status;

                        $.post('@Url.Action("SetStatus")', data)
                            .done(function (res) {
                                if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                                else { toastr.error(res.message); }
                            })
                            .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                    });
                });

            $(document).on('click', '.js-delete-transaction', function () {
                var $btn = $(this);

                Swal.fire({
                    title: 'Delete transaction?',
                    text: $btn.data('label') + ' will be removed and the balance recalculated.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f46a6a',
                    cancelButtonColor: '#74788d',
                    confirmButtonText: 'Yes, delete it'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('@Url.Action("Delete", "Transaction")', { id: $btn.data('id'), __RequestVerificationToken: token })
                        .done(function (res) {
                            if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                            else { toastr.error(res.message); }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });
        });
    </script>
}
