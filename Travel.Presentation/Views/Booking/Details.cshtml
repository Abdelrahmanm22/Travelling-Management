@model Travel.Domain.Models.Booking
@using Travel.Domain.Enums
@{
    ViewData["Title"] = $"{Model.Code} — {Model.LeadGuestName}";
    var categoryText = Model.Category == PackageCategory.FiveStars ? "5 ★" : "4 ★";
    var rooming = Model.Rooms.OrderBy(r => r.SortOrder)
        .Select(r => $"{r.Quantity} × {(r.Type == RoomType.Single ? "SGL" : r.Type == RoomType.Double ? "DBL" : "TRP")}")
        .ToList();

    var paxParts = new List<string> { $"{Model.Adults} adult{(Model.Adults == 1 ? "" : "s")}" };
    if (Model.Children > 0) paxParts.Add($"{Model.Children} child{(Model.Children == 1 ? "" : "ren")}");
    if (Model.Infants > 0) paxParts.Add($"{Model.Infants} infant{(Model.Infants == 1 ? "" : "s")}");

    var attachmentGroups = new[]
    {
        (Label: "Flights", Category: AttachmentCategory.Flight, Icon: "bxs-plane-alt"),
        (Label: "Passports", Category: AttachmentCategory.Passport, Icon: "bx-id-card"),
        (Label: "Domestic flights", Category: AttachmentCategory.DomesticFlight, Icon: "bxs-plane"),
    };
    var contract = Model.Attachments.FirstOrDefault(a => a.Category == AttachmentCategory.Contract);
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card print-sheet">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <span class="badge bg-primary-subtle text-primary font-monospace mb-1">@Model.Code</span>
                        <h4 class="mb-1">
                            @Model.LeadGuestName
                            <span class="badge bg-warning-subtle text-warning align-middle ms-1">@categoryText</span>
                        </h4>
                        <div class="text-muted">
                            @Model.Package?.Name · @Model.Pax PAX
                            <span class="ms-1">(@string.Join(", ", paxParts))</span>
                        </div>
                    </div>
                    <div class="text-nowrap d-print-none">
                        <button type="button" class="btn btn-light btn-sm" onclick="window.print()">
                            <i class="bx bx-printer me-1"></i>Print
                        </button>
                        <permission required="@Permissions.Bookings.Export">
                            <a asp-action="Export" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                                <i class="bx bx-spreadsheet me-1"></i>Excel
                            </a>
                        </permission>
                        <permission required="@Permissions.Bookings.Edit">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bx bx-pencil me-1"></i>Edit</a>
                        </permission>
                        <a asp-action="Index" class="btn btn-light btn-sm">Back</a>
                    </div>
                </div>

                @if (Model.ExtraNights > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bx bx-error-circle me-1"></i>
                        This booking includes @Model.ExtraNights extra night@(Model.ExtraNights > 1 ? "s" : "") beyond the package total.
                        @Model.ExtensionReason
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Arrival</h6><p class="mb-0 fw-semibold">@Model.ArrivalDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Departure</h6><p class="mb-0 fw-semibold">@Model.DepartureDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Email / Phone</h6><p class="mb-0">@Model.GuestEmail<br />@Model.GuestPhone</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Nationality</h6><p class="mb-0">@Model.Nationality</p></div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bxs-plane-land me-1"></i>Arrival flight</h6>
                        <p class="mb-0 fw-semibold">@(string.IsNullOrWhiteSpace(Model.ArrivalFlightNo) ? "—" : Model.ArrivalFlightNo)</p>
                        <p class="mb-0 text-muted">
                            Flight: @(Model.FlightArrivalDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (Model.ArrivalTime is not null)
                            {
                                <text>· @Model.ArrivalTime.Value.ToString("HH:mm")</text>
                            }
                        </p>
                        <p class="mb-0 text-muted">Package: @Model.ArrivalDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bxs-plane-take-off me-1"></i>Departure flight</h6>
                        <p class="mb-0 fw-semibold">@(string.IsNullOrWhiteSpace(Model.DepartureFlightNo) ? "—" : Model.DepartureFlightNo)</p>
                        <p class="mb-0 text-muted">
                            Flight: @(Model.FlightDepartureDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (Model.DepartureTime is not null)
                            {
                                <text>· @Model.DepartureTime.Value.ToString("HH:mm")</text>
                            }
                        </p>
                        <p class="mb-0 text-muted">Package: @Model.DepartureDate.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-8">
                        <h5 class="mb-3">Guests</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>#</th><th>Name</th><th>Type</th><th class="text-end">Age</th></tr>
                                </thead>
                                <tbody>
                                    @{ var g = 1; }
                                    @foreach (var guest in Model.Guests.OrderBy(x => x.SortOrder))
                                    {
                                        <tr>
                                            <td>@g</td>
                                            <td>
                                                @guest.FullName
                                                @if (guest.IsLeadGuest)
                                                {
                                                    <span class="badge bg-success-subtle text-success ms-1">lead</span>
                                                }
                                            </td>
                                            <td>@(guest.Type == GuestType.Adult ? "Adult" : guest.Type == GuestType.Child ? "Child (6-12)" : "Infant (0-5)")</td>
                                            <td class="text-end">@(guest.Age?.ToString() ?? "—")</td>
                                        </tr>
                                        g++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h5 class="mb-3">Rooms</h5>
                        <p class="mb-0 fw-semibold">@(rooming.Count > 0 ? string.Join(" · ", rooming) : "—")</p>
                        <small class="text-muted">@Model.Rooms.Sum(r => r.Quantity) room@(Model.Rooms.Sum(r => r.Quantity) == 1 ? "" : "s") in total</small>
                    </div>
                </div>

                <h5 class="mb-3">Schedule</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr><th>#</th><th>Stay</th><th>Check-in</th><th>Check-out</th><th class="text-end">Nights</th><th>Hotel</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @{ var i = 1; }
                            @foreach (var s in Model.Stays.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        @if (s.IsCruise)
                                        {
                                            <i class="bx bxs-ship me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bx bx-buildings me-1"></i>
                                        }
                                        @s.Destination?.Name
                                        @if (s.IsOverridden)
                                        {
                                            <span class="badge bg-info-subtle text-info ms-1">edited</span>
                                        }
                                    </td>
                                    <td>@s.CheckInDate.ToString("dd MMM yyyy")</td>
                                    <td>@s.CheckInDate.AddDays(s.Nights).ToString("dd MMM yyyy")</td>
                                    <td class="text-end">@s.Nights</td>
                                    <td>@(s.HotelName ?? "—")</td>
                                    <td>@(s.Notes ?? "—")</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <h6 class="text-muted text-uppercase font-size-12 mt-3">Notes</h6>
                    <p class="mb-0">@Model.Notes</p>
                }

                @if (Model.Attachments.Any())
                {
                    <h5 class="mt-4 mb-3">Attachments</h5>
                    <div class="row">
                        @foreach (var group in attachmentGroups)
                        {
                            var files = Model.Attachments.Where(a => a.Category == group.Category).ToList();
                            if (files.Count == 0)
                                continue;

                            <div class="col-md-4 mb-3">
                                <h6 class="text-muted text-uppercase font-size-12"><i class="bx @group.Icon me-1"></i>@group.Label</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var a in files)
                                    {
                                        var isPdf = a.FileUrl != null && a.FileUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                        <li>
                                            <a href="@a.FileUrl" target="_blank">
                                                <i class="bx @(isPdf ? "bxs-file-pdf" : "bxs-file-image") me-1"></i>@a.OriginalFileName
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        @if (contract is not null)
                        {
                            <div class="col-md-4 mb-3">
                                <h6 class="text-muted text-uppercase font-size-12"><i class="bx bx-link me-1"></i>Contract</h6>
                                <a href="@contract.LinkUrl" target="_blank"><i class="bx bx-link-external me-1"></i>Open contract</a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
