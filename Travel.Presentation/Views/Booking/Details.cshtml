@model Travel.Domain.Models.Booking
@using Travel.Domain.Enums
@{
    ViewData["Title"] = $"Booking — {Model.LeadGuestName}";
    var categoryText = Model.Category == PackageCategory.FiveStars ? "5 ★" : "4 ★";
    var rooming = Model.Rooms.OrderBy(r => r.SortOrder)
        .Select(r => $"{r.Quantity} × {(r.Type == RoomType.Single ? "SGL" : r.Type == RoomType.Double ? "DBL" : "TRP")}")
        .ToList();

    var paxParts = new List<string> { $"{Model.Adults} adult{(Model.Adults == 1 ? "" : "s")}" };
    if (Model.Children > 0) paxParts.Add($"{Model.Children} child{(Model.Children == 1 ? "" : "ren")}");
    if (Model.Infants > 0) paxParts.Add($"{Model.Infants} infant{(Model.Infants == 1 ? "" : "s")}");
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h4 class="mb-1">
                            @Model.LeadGuestName
                            <span class="badge bg-warning-subtle text-warning align-middle ms-1">@categoryText</span>
                        </h4>
                        <div class="text-muted">
                            @Model.Package?.Name · @Model.Pax PAX
                            <span class="ms-1">(@string.Join(", ", paxParts))</span>
                        </div>
                    </div>
                    <div class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bx bx-pencil me-1"></i>Edit</a>
                        <a asp-action="Index" class="btn btn-light btn-sm">Back</a>
                    </div>
                </div>

                @if (Model.ExtraNights > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bx bx-error-circle me-1"></i>
                        This booking includes @Model.ExtraNights extra night@(Model.ExtraNights > 1 ? "s" : "") beyond the package total.
                        @Model.ExtensionReason
                    </div>
                }

                <div class="row mb-4">
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Arrival</h6><p class="mb-0 fw-semibold">@Model.ArrivalDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Departure</h6><p class="mb-0 fw-semibold">@Model.DepartureDate.ToString("dd MMM yyyy")</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Email / Phone</h6><p class="mb-0">@Model.GuestEmail<br />@Model.GuestPhone</p></div>
                    <div class="col-md-3"><h6 class="text-muted text-uppercase font-size-12">Nationality</h6><p class="mb-0">@Model.Nationality</p></div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bx-plane-land me-1"></i>Arrival flight</h6>
                        <p class="mb-0 fw-semibold">@Model.ArrivalFlightNo</p>
                        <p class="mb-0 text-muted">@Model.ArrivalDate.ToString("dd MMM yyyy") · @Model.ArrivalTime.ToString("HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12"><i class="bx bx-plane-take-off me-1"></i>Departure flight</h6>
                        <p class="mb-0 fw-semibold">@Model.DepartureFlightNo</p>
                        <p class="mb-0 text-muted">@Model.DepartureDate.ToString("dd MMM yyyy") · @Model.DepartureTime.ToString("HH:mm")</p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-8">
                        <h5 class="mb-3">Guests</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>#</th><th>Name</th><th>Type</th><th class="text-end">Age</th></tr>
                                </thead>
                                <tbody>
                                    @{ var g = 1; }
                                    @foreach (var guest in Model.Guests.OrderBy(x => x.SortOrder))
                                    {
                                        <tr>
                                            <td>@g</td>
                                            <td>
                                                @guest.FullName
                                                @if (guest.IsLeadGuest)
                                                {
                                                    <span class="badge bg-success-subtle text-success ms-1">lead</span>
                                                }
                                            </td>
                                            <td>@(guest.Type == GuestType.Adult ? "Adult" : guest.Type == GuestType.Child ? "Child (6-12)" : "Infant (0-5)")</td>
                                            <td class="text-end">@(guest.Age?.ToString() ?? "—")</td>
                                        </tr>
                                        g++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h5 class="mb-3">Rooms</h5>
                        <p class="mb-0 fw-semibold">@(rooming.Count > 0 ? string.Join(" · ", rooming) : "—")</p>
                        <small class="text-muted">@Model.Rooms.Sum(r => r.Quantity) room@(Model.Rooms.Sum(r => r.Quantity) == 1 ? "" : "s") in total</small>
                    </div>
                </div>

                <h5 class="mb-3">Schedule</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr><th>#</th><th>Stay</th><th>Check-in</th><th>Check-out</th><th class="text-end">Nights</th><th>Hotel</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @{ var i = 1; }
                            @foreach (var s in Model.Stays.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        @if (s.IsCruise)
                                        {
                                            <i class="bx bx-ship me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bx bx-buildings me-1"></i>
                                        }
                                        @s.Destination?.Name
                                        @if (s.IsOverridden)
                                        {
                                            <span class="badge bg-info-subtle text-info ms-1">edited</span>
                                        }
                                    </td>
                                    <td>@s.CheckInDate.ToString("dd MMM yyyy")</td>
                                    <td>@s.CheckInDate.AddDays(s.Nights).ToString("dd MMM yyyy")</td>
                                    <td class="text-end">@s.Nights</td>
                                    <td>@(s.HotelName ?? "—")</td>
                                    <td>@(s.Notes ?? "—")</td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <h6 class="text-muted text-uppercase font-size-12 mt-3">Notes</h6>
                    <p class="mb-0">@Model.Notes</p>
                }
            </div>
        </div>
    </div>
</div>
