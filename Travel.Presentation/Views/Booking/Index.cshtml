@model IEnumerable<Travel.Domain.Models.Booking>
@using Travel.Domain.Enums
@{
    ViewData["Title"] = "Bookings";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0">Bookings</h4>
                    <a asp-action="Create" class="btn btn-primary waves-effect waves-light">
                        <i class="bx bx-plus me-1"></i> New Booking
                    </a>
                </div>

                <div class="table-responsive">
                    <table id="bookings-table" class="table table-hover align-middle mb-0" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th>Guest</th>
                                <th>Package</th>
                                <th>Arrival → Departure</th>
                                <th>PAX</th>
                                <th>Category</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @b.LeadGuestName
                                        @if (b.ExtraNights > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning ms-1" title="@b.ExtensionReason">
                                                <i class="bx bx-error-circle"></i> +@b.ExtraNights night@(b.ExtraNights > 1 ? "s" : "")
                                            </span>
                                        }
                                    </td>
                                    <td>@b.Package?.Name</td>
                                    <td>@b.ArrivalDate.ToString("dd MMM yyyy") <span class="text-muted">→</span> @b.DepartureDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @b.Pax
                                        @{
                                            var parts = new List<string> { $"{b.Adults}A" };
                                            if (b.Children > 0) parts.Add($"{b.Children}C");
                                            if (b.Infants > 0) parts.Add($"{b.Infants}I");
                                        }
                                        <small class="text-muted">(@string.Join(" · ", parts))</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning-subtle text-warning">
                                            @(b.Category == PackageCategory.FiveStars ? "5 ★" : "4 ★")
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-soft-secondary" title="Details"><i class="bx bx-show"></i></a>
                                        <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-soft-primary" title="Edit"><i class="bx bx-pencil"></i></a>
                                        <button type="button" class="btn btn-sm btn-soft-danger js-delete" data-id="@b.Id" data-name="@b.LeadGuestName" title="Delete"><i class="bx bx-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            $('#bookings-table').DataTable({ order: [[2, 'desc']], columnDefs: [{ orderable: false, targets: 5 }] });
            var token = $('input[name="__RequestVerificationToken"]').val();

            $('#bookings-table').on('click', '.js-delete', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                Swal.fire({
                    title: 'Delete booking?',
                    text: 'The booking for “' + name + '” and its schedule will be permanently removed.',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonColor: '#f46a6a', cancelButtonColor: '#74788d', confirmButtonText: 'Yes, delete it'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    $.post('@Url.Action("Delete")', { id: id, __RequestVerificationToken: token })
                        .done(function (res) {
                            if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                            else { toastr.error(res.message); }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });
        });
    </script>
}
