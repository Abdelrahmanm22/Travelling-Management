@model Travel.Presentation.ViewModels.BookingListViewModel
@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@{
    ViewData["Title"] = "Bookings";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-sm-6 col-md-3 col-xl-3">
                        <label asp-for="ArrivalFrom" class="form-label"></label>
                        <input asp-for="ArrivalFrom" type="date" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3 col-xl-3">
                        <label asp-for="ArrivalTo" class="form-label"></label>
                        <input asp-for="ArrivalTo" type="date" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-3 col-xl-2">
                        <label asp-for="PackageId" class="form-label"></label>
                        <select asp-for="PackageId" asp-items="Model.PackageOptions" class="form-select">
                            <option value="">All packages</option>
                        </select>
                    </div>
                    <div class="col-sm-6 col-md-3 col-xl-2">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<BookingStatus>()" class="form-select">
                            <option value="">All statuses</option>
                        </select>
                    </div>
                    <div class="col-12 col-xl-2 text-sm-end">
                        <button type="submit" class="btn btn-primary waves-effect waves-light">
                            <i class="bx bx-filter-alt me-1"></i> Apply
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <i class="bx bx-x me-1"></i> Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="card-title mb-0">Bookings</h4>
                        <span class="badge bg-primary-subtle text-primary">
                            @Model.Bookings.Count booking@(Model.Bookings.Count == 1 ? "" : "s")
                        </span>
                    </div>
                    <permission required="@Permissions.Bookings.Create">
                        <a asp-action="Create" class="btn btn-primary waves-effect waves-light">
                            <i class="bx bx-plus me-1"></i> New Booking
                        </a>
                    </permission>
                </div>

                @if (Model.Bookings.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bx bx-calendar-x text-muted" style="font-size:3rem"></i>
                        @if (Model.HasFilters)
                        {
                            <h5 class="mt-3">No bookings match these filters</h5>
                            <p class="text-muted mb-0">Try widening the arrival date range or clearing the package and status filters.</p>
                        }
                        else
                        {
                            <h5 class="mt-3">No bookings yet</h5>
                            <p class="text-muted mb-0">Create the first booking to see it listed here.</p>
                        }
                    </div>
                }
                else
                {
                <div class="table-responsive">
                    <table id="bookings-table" class="table table-hover align-middle mb-0" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th style="width:130px">Code</th>
                                <th>Guest</th>
                                <th>Package</th>
                                <th>Arrival → Departure</th>
                                <th>PAX</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Bookings)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary font-monospace">@b.Code</span>
                                    </td>
                                    <td class="fw-semibold">
                                        @b.LeadGuestName
                                        @if (b.ExtraNights > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning ms-1" title="@b.ExtensionReason">
                                                <i class="bx bx-error-circle"></i> +@b.ExtraNights night@(b.ExtraNights > 1 ? "s" : "")
                                            </span>
                                        }
                                    </td>
                                    <td>@b.Package?.Name</td>
                                    <td data-order="@b.ArrivalDate.ToString("yyyy-MM-dd")">@b.ArrivalDate.ToString("dd MMM yyyy") <span class="text-muted">→</span> @b.DepartureDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @b.Pax
                                        @{
                                            var parts = new List<string> { $"{b.Adults}A" };
                                            if (b.Children > 0) parts.Add($"{b.Children}C");
                                            if (b.Infants > 0) parts.Add($"{b.Infants}I");
                                        }
                                        <small class="text-muted">(@string.Join(" · ", parts))</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning-subtle text-warning">
                                            @(b.Category == PackageCategory.FiveStars ? "5 ★" : "4 ★")
                                        </span>
                                    </td>
                                    <td data-order="@((int)b.Status)">
                                        @{
                                            var statusBadge = StatusBadges.ForBooking(b.Status);
                                        }
                                        <span class="badge @statusBadge.CssClass">
                                            <i class="bx @statusBadge.Icon me-1"></i>@statusBadge.Label
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-soft-secondary" title="Details"><i class="bx bx-show"></i></a>
                                        <permission required="@Permissions.Bookings.ChangeStatus">
                                            <partial name="_BookingStatusActions" model="b" />
                                        </permission>
                                        <permission required="@Permissions.Bookings.Edit">
                                            <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-soft-primary" title="Edit"><i class="bx bx-pencil"></i></a>
                                        </permission>
                                        <permission required="@Permissions.Bookings.Delete">
                                            <button type="button" class="btn btn-sm btn-soft-danger js-delete" data-id="@b.Id" data-code="@b.Code" data-name="@b.LeadGuestName" title="Delete"><i class="bx bx-trash"></i></button>
                                        </permission>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            // Positional — the Status column pushed Actions from 6 to 7.
            $('#bookings-table').DataTable({ order: [[3, 'desc']], columnDefs: [{ orderable: false, targets: 7 }] });
            var token = $('input[name="__RequestVerificationToken"]').val();

            $('#bookings-table').on('click', '.js-booking-status', function () {
                var $btn = $(this);
                var status = $btn.data('status');

                Swal.fire({
                    title: $btn.data('title'),
                    text: $btn.data('code') + ' — ' + $btn.data('text'),
                    icon: $btn.data('danger') ? 'warning' : 'question',
                    showCancelButton: true,
                    confirmButtonColor: $btn.data('danger') ? '#f46a6a' : '#556ee6',
                    cancelButtonColor: '#74788d',
                    confirmButtonText: 'Yes, continue'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    // An empty status means "reactivate" — the server recomputes it from the blocks.
                    var data = { id: $btn.data('id'), __RequestVerificationToken: token };
                    if (status !== '' && status !== undefined) data.status = status;

                    $.post('@Url.Action("SetStatus")', data)
                        .done(function (res) {
                            if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                            else { toastr.error(res.message); }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });

            $('#bookings-table').on('click', '.js-delete', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var code = $(this).data('code');
                Swal.fire({
                    title: 'Delete booking?',
                    text: code + ' — the booking for “' + name + '” and its schedule will be permanently removed.',
                    icon: 'warning', showCancelButton: true,
                    confirmButtonColor: '#f46a6a', cancelButtonColor: '#74788d', confirmButtonText: 'Yes, delete it'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    $.post('@Url.Action("Delete")', { id: id, __RequestVerificationToken: token })
                        .done(function (res) {
                            if (res.success) { toastr.success(res.message); setTimeout(function () { location.reload(); }, 800); }
                            else { toastr.error(res.message); }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });
        });
    </script>
}
