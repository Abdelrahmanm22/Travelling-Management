@using Travel.Presentation.Helpers
@model Travel.Presentation.ViewModels.BookingViewModel

@*
    Gated on Bookings.EditPricing rather than Tours.View: the row is inseparable from its price, and
    there is no useful "tours without money" version of this card. A user who can't price a booking
    also doesn't sell tours on it.
*@
@if (Model.CanEditPricing)
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0"><i class="bx bx-compass me-1"></i> Extra Tours</h4>
                <span class="badge bg-info-subtle text-info fs-6" id="tours-total">@Money.Format(Model.Tours.Sum(t => t.GuestIndexes.Distinct().Count() * t.UnitPrice))</span>
            </div>

            <partial name="_BookingTourRows" model="Model" />
        </div>
    </div>
}
