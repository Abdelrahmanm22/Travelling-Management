@model Travel.Presentation.ViewModels.BookingViewModel
@using Travel.Domain.Enums

@* Guest roster — rows are generated from the Adults/Children/Infants counts by booking-form.js,
   which also reindexes the names and keeps the lead radio on an adult row. *@
<div class="table-responsive">
    <table class="table align-middle mb-2" id="guests-table">
        <thead class="table-light">
            <tr>
                <th style="width:60px" class="text-center">Lead</th>
                <th style="width:40px">#</th>
                <th>Full name</th>
                <th style="width:150px">Type</th>
                <th style="width:110px">Age</th>
            </tr>
        </thead>
        <tbody id="guests-container">
            @for (int i = 0; i < Model.Guests.Count; i++)
            {
                var guest = Model.Guests[i];
                var isAdult = guest.Type == GuestType.Adult;
                var isChild = guest.Type == GuestType.Child;
                <tr class="guest-row" data-type="@guest.Type">
                    <td class="text-center">
                        <input type="radio" name="LeadGuestIndex" value="@i" class="form-check-input guest-lead"
                               title="Lead guest" @(i == Model.LeadGuestIndex ? "checked" : "") @(isAdult ? "" : "disabled") />
                    </td>
                    <td class="guest-index">@(i + 1)</td>
                    <td>
                        <input name="Guests[@i].FullName" value="@guest.FullName" maxlength="150"
                               class="form-control form-control-sm guest-name" placeholder="Full name as in passport" />
                        @Html.ValidationMessage($"Guests[{i}].FullName", new { @class = "text-danger small" })
                    </td>
                    <td>
                        <input type="hidden" name="Guests[@i].Type" value="@guest.Type" class="guest-type" />
                        <span class="badge @(isAdult ? "bg-primary-subtle text-primary" : isChild ? "bg-info-subtle text-info" : "bg-secondary-subtle text-secondary") guest-type-label">
                            @(isAdult ? "Adult" : isChild ? "Child (6-12)" : "Infant (0-5)")
                        </span>
                    </td>
                    <td>
                        <input name="Guests[@i].Age" type="number" value="@(guest.Age?.ToString())"
                               min="@(isChild ? 6 : 0)" max="@(isChild ? 12 : 5)"
                               class="form-control form-control-sm guest-age @(isAdult ? "d-none" : "")"
                               @(isAdult ? "disabled" : "") placeholder="Age" />
                        @if (isAdult)
                        {
                            <span class="text-muted guest-age-dash">—</span>
                        }
                        @Html.ValidationMessage($"Guests[{i}].Age", new { @class = "text-danger small" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<span asp-validation-for="LeadGuestIndex" class="text-danger d-block"></span>
<small class="text-muted">Rows follow the counts above. The lead guest must be an adult.</small>

<template id="guest-row-template">
    <tr class="guest-row" data-type="Adult">
        <td class="text-center">
            <input type="radio" name="LeadGuestIndex" value="__INDEX__" class="form-check-input guest-lead" title="Lead guest" />
        </td>
        <td class="guest-index"></td>
        <td>
            <input name="Guests[__INDEX__].FullName" maxlength="150" class="form-control form-control-sm guest-name" placeholder="Full name as in passport" />
        </td>
        <td>
            <input type="hidden" name="Guests[__INDEX__].Type" value="Adult" class="guest-type" />
            <span class="badge bg-primary-subtle text-primary guest-type-label">Adult</span>
        </td>
        <td>
            <input name="Guests[__INDEX__].Age" type="number" min="0" max="5" class="form-control form-control-sm guest-age d-none" disabled placeholder="Age" />
            <span class="text-muted guest-age-dash">—</span>
        </td>
    </tr>
</template>
