@model Travel.Presentation.ViewModels.ToursReportViewModel
@{
    ViewData["Title"] = "Tours Report";
}

<div class="row d-print-none">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    @* Tells the server this range was chosen, so a cleared From box isn't refilled with today. *@
                    <input type="hidden" name="applied" value="true" />
                    <div class="col-sm-6 col-md-4 col-xl-3">
                        <label asp-for="From" class="form-label"></label>
                        <input asp-for="From" type="date" class="form-control" />
                    </div>
                    <div class="col-sm-6 col-md-4 col-xl-3">
                        <label asp-for="To" class="form-label"></label>
                        <input asp-for="To" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-4 col-xl-6 text-sm-end">
                        <button type="submit" class="btn btn-primary waves-effect waves-light">
                            <i class="bx bx-filter-alt me-1"></i> Apply
                        </button>
                        <a asp-action="Tours" class="btn btn-light">
                            <i class="bx bx-x me-1"></i> Reset
                        </a>
                    </div>
                </form>
                <p class="text-muted small mb-0 mt-3">
                    <i class="bx bx-info-circle me-1"></i>
                    A booking is listed when it has at least one extra tour and its trip is running at any point
                    inside the range. Every guest on it gets a row, including guests taking no tour.
                </p>
            </div>
        </div>
    </div>
</div>

@if (Model.UnrecordedTourCount > 0)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 d-print-none" role="alert">
        <i class="bx bx-error-circle font-size-18"></i>
        <div>
            <strong>@Model.UnrecordedTourCount tour@(Model.UnrecordedTourCount == 1 ? " was" : "s were") sold before guest names were recorded.</strong>
            Their pax count is shown on the booking's first row, highlighted below — open the booking and tick
            who is taking them.
        </div>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card print-sheet">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="card-title mb-1">
                            <i class="bx bx-compass me-1"></i> Tours
                        </h4>
                        <p class="text-muted mb-0">
                            @Model.BookingCount booking@(Model.BookingCount == 1 ? "" : "s")
                            · @Model.GuestCount guest@(Model.GuestCount == 1 ? "" : "s")
                            · @Model.Tours.Count tour@(Model.Tours.Count == 1 ? "" : "s")
                            @if (Model.HasFilters)
                            {
                                <text>· @(Model.From?.ToString("dd MMM yyyy") ?? "any") → @(Model.To?.ToString("dd MMM yyyy") ?? "any")</text>
                            }
                        </p>
                    </div>
                    <div class="d-print-none text-nowrap">
                        <button type="button" class="btn btn-light waves-effect" onclick="window.print()">
                            <i class="bx bx-printer me-1"></i> Print
                        </button>
                        <permission required="@Permissions.Reports.ExportTours">
                            <a asp-action="ExportTours"
                               asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                               asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                               asp-route-applied="true"
                               class="btn btn-success waves-effect waves-light">
                                <i class="bx bx-spreadsheet me-1"></i> Excel
                            </a>
                        </permission>
                    </div>
                </div>

                @if (Model.Bookings.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bx bx-compass text-muted" style="font-size:3rem"></i>
                        @if (Model.HasFilters)
                        {
                            <h5 class="mt-3">No tours in this range</h5>
                            <p class="text-muted mb-0">Try widening the dates — a booking is listed only when its trip overlaps them and it has an extra tour.</p>
                        }
                        else
                        {
                            <h5 class="mt-3">No tours to show</h5>
                            <p class="text-muted mb-0">Add an extra tour to a booking to see its guests listed here.</p>
                        }
                    </div>
                }
                else
                {
                    @* No DataTables: it doesn't support rowspan in tbody, and the rows already come sorted by arrival. *@
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0" style="width:100%">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width:130px">Booking No</th>
                                    <th>Pax Name</th>
                                    @foreach (var t in Model.Tours)
                                    {
                                        <th>@t.Name</th>
                                    }
                                    <th>Arrival</th>
                                    <th>Departure</th>
                                    <th>Package</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.Bookings)
                                {
                                    var span = b.Guests.Count;
                                    for (var i = 0; i < span; i++)
                                    {
                                        var g = b.Guests[i];
                                        <tr>
                                            @if (i == 0)
                                            {
                                                <td rowspan="@span">
                                                    <span class="badge bg-primary-subtle text-primary font-monospace">@b.BookingCode</span>
                                                </td>
                                            }
                                            <td class="fw-bold">@g.Name</td>
                                            @foreach (var t in Model.Tours)
                                            {
                                                var taken = g.TourIds.Contains(t.TourId);
                                                var unnamed = i == 0 && b.UnnamedPax.TryGetValue(t.TourId, out var pax) ? pax : 0;
                                                <td class="text-center @(unnamed > 0 ? "bg-warning-subtle" : "")">
                                                    @if (taken)
                                                    {
                                                        <i class="bx bx-check text-success font-size-18" aria-label="Taking this tour"></i>
                                                    }
                                                    @if (unnamed > 0)
                                                    {
                                                        <div class="small text-warning text-nowrap">@unnamed pax — names not recorded</div>
                                                    }
                                                </td>
                                            }
                                            @if (i == 0)
                                            {
                                                <td rowspan="@span" class="text-center text-nowrap">@b.ArrivalDate.ToString("dd-MMM")</td>
                                                <td rowspan="@span" class="text-center text-nowrap">@b.DepartureDate.ToString("dd-MMM")</td>
                                                <td rowspan="@span">@b.PackageName</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
