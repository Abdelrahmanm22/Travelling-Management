@using Travel.Domain.Enums
@model IEnumerable<Travel.Domain.Models.MovementType>
@{
    ViewData["Title"] = "Movement Types";
}

<link href="~/back/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />

@Html.AntiForgeryToken()

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="card-title mb-0"><i class="bx bx-transfer me-1"></i> Movement Types</h4>
                    <permission required="@Permissions.MovementTypes.Create">
                        <a asp-action="Create" class="btn btn-primary waves-effect waves-light">
                            <i class="bx bx-plus me-1"></i> New Type
                        </a>
                    </permission>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
                        <i class="bx bx-info-circle font-size-18"></i>
                        <div>No movement types yet. Add the kinds of trips your drivers make — airport arrivals and departures, day tours — and they appear on the movements board's palette.</div>
                    </div>
                }

                <div class="table-responsive">
                    <table id="movement-types-table" class="table table-hover align-middle mb-0" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Flight</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@type.Name</td>
                                    <td>
                                        @if (type.FlightLeg is { } leg)
                                        {
                                            <span class="badge bg-info-subtle text-info"><i class="bx @(leg.IsArrival() ? "bxs-plane-land" : "bxs-plane-take-off") me-1"></i>@leg.Label()</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not a flight</span>
                                        }
                                    </td>
                                    <td data-order="@(type.IsActive ? 0 : 1)">
                                        <span class="badge @(type.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                            @(type.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <permission required="@Permissions.MovementTypes.Edit">
                                            <a asp-action="Edit" asp-route-id="@type.Id" class="btn btn-sm btn-soft-primary" title="Edit">
                                                <i class="bx bx-pencil"></i>
                                            </a>
                                        </permission>
                                        <permission required="@Permissions.MovementTypes.Delete">
                                            <button type="button" class="btn btn-sm btn-soft-danger js-delete" data-id="@type.Id" data-name="@type.Name" title="Delete">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </permission>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/back/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/back/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            $('#movement-types-table').DataTable({ order: [[0, 'asc']], columnDefs: [{ orderable: false, targets: 3 }] });

            var token = $('input[name="__RequestVerificationToken"]').val();

            $('#movement-types-table').on('click', '.js-delete', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');

                Swal.fire({
                    title: 'Delete movement type?',
                    text: '“' + name + '” will be permanently removed.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f46a6a',
                    cancelButtonColor: '#74788d',
                    confirmButtonText: 'Yes, delete it'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('@Url.Action("Delete")', { id: id, __RequestVerificationToken: token })
                        .done(function (res) {
                            if (res.success) {
                                toastr.success(res.message);
                                setTimeout(function () { location.reload(); }, 800);
                            } else {
                                toastr.error(res.message);
                            }
                        })
                        .fail(function () { toastr.error('Something went wrong. Please try again.'); });
                });
            });
        });
    </script>
}
