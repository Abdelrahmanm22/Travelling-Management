@using Travel.Domain.Enums
@using Travel.Presentation.Helpers
@model AppTheme
<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] | Musta Travel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Musta Travel — internal operations management" name="description" />
    <meta content="Musta Travel" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/back/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="@Url.Content(ThemeAssets.BootstrapCss(Model))" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/back/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="@Url.Content(ThemeAssets.AppCss(Model))" id="app-style" rel="stylesheet" type="text/css" />

    <!-- SweetAlert2 (local) -->
    <link href="~/back/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" type="text/css" />

    <!-- Project-owned styles — must stay last and must NOT have an id (theme-sync.js rewrites the
         href of #bootstrap-style / #app-style only). -->
    <link href="~/css/app-extras.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- Caches the account's theme in localStorage and drives the topbar toggle — see the file. -->
    <script src="~/js/theme-sync.js" asp-append-version="true"></script>

</head>