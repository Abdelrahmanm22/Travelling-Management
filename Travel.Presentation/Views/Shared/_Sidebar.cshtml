<div class="vertical-menu">

    <div data-simplebar class="h-100">

        <!--- Sidemenu -->
        <div id="sidebar-menu">
            <!-- Left Menu Start -->
            <ul class="metismenu list-unstyled" id="side-menu">

                <li class="menu-title">Menu</li>

                <li>
                    <a asp-controller="Home" asp-action="Index" class="waves-effect">
                        <i class="bx bx-home-circle"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <permission required="@Permissions.Bookings.View,@Permissions.BlockServices.View,@Permissions.Packages.View,@Permissions.Destinations.View,@Permissions.Nationalities.View" mode="any">
                    <li class="menu-title">Travel</li>
                </permission>
                <permission required="@Permissions.Bookings.View">
                    <li>
                        <a asp-controller="Booking" asp-action="Index" class="waves-effect">
                            <i class="bx bx-calendar-check"></i>
                            <span>Bookings</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.BlockServices.View">
                    <li>
                        <a asp-controller="BlockService" asp-action="Index" class="waves-effect">
                            <i class="bx bx-layer"></i>
                            <span>Block Services</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Packages.View">
                    <li>
                        <a asp-controller="Package" asp-action="Index" class="waves-effect">
                            <i class="bx bx-package"></i>
                            <span>Packages</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Destinations.View">
                    <li>
                        <a asp-controller="Destination" asp-action="Index" class="waves-effect">
                            <i class="bx bx-map-pin"></i>
                            <span>Destinations</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Nationalities.View">
                    <li>
                        <a asp-controller="Nationality" asp-action="Index" class="waves-effect">
                            <i class="bx bx-flag"></i>
                            <span>Nationalities</span>
                        </a>
                    </li>
                </permission>

                <permission required="@Permissions.Reports.ViewFlights" mode="any">
                    <li class="menu-title">Reports</li>
                    <li>
                        <a href="javascript: void(0);" class="has-arrow waves-effect">
                            <i class="bx bx-bar-chart-alt-2"></i>
                            <span>Reports</span>
                        </a>
                        <ul class="sub-menu" aria-expanded="false">
                            <permission required="@Permissions.Reports.ViewFlights">
                                <li>
                                    <a asp-controller="Report" asp-action="Flights">Flights</a>
                                </li>
                            </permission>
                        </ul>
                    </li>
                </permission>

                <permission required="@Permissions.Users.View,@Permissions.Roles.View" mode="any">
                    <li class="menu-title">Administration</li>
                </permission>
                <permission required="@Permissions.Users.View">
                    <li>
                        <a asp-controller="User" asp-action="Index" class="waves-effect">
                            <i class="bx bx-group"></i>
                            <span>Users</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Roles.View">
                    <li>
                        <a asp-controller="Role" asp-action="Index" class="waves-effect">
                            <i class="bx bx-shield-quarter"></i>
                            <span>Roles</span>
                        </a>
                    </li>
                </permission>

            </ul>
        </div>
        <!-- Sidebar -->
    </div>
</div>
