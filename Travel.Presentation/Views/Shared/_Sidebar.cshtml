@functions {
    // Skote's app.js only highlights a link whose URL matches exactly, so Details/Create/Edit
    // pages lit nothing. Match on the controller instead (and the action, for ReportController,
    // which hosts several reports). Null renders no attribute.
    string? ActiveItem(string controller, string? action = null) =>
        IsCurrent(controller, action) ? "mm-active" : null;

    string? ActiveLink(string controller, string? action = null) =>
        IsCurrent(controller, action) ? "active" : null;

    bool IsCurrent(string controller, string? action) =>
        string.Equals(ViewContext.RouteData.Values["controller"] as string, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(ViewContext.RouteData.Values["action"] as string, action, StringComparison.OrdinalIgnoreCase));

    // Which of the two arrival lists is current: the list action itself, or — on Details — the
    // list that file belongs to, set by the view as ViewData["BlockList"].
    string? BlockList() =>
        IsCurrent("BlockService", "Index") ? "Index"
        : IsCurrent("BlockService", "SingleArrivals") ? "SingleArrivals"
        : IsCurrent("BlockService", "Details") ? ViewData["BlockList"] as string
        : null;

    // Switching between the two lists keeps the current filters. Only from a list page: Details'
    // query string is a group key, not filters.
    string BlockListUrl(string action)
    {
        var url = Url.Action(action, "BlockService")!;
        return IsCurrent("BlockService", "Index") || IsCurrent("BlockService", "SingleArrivals")
            ? url + Context.Request.QueryString
            : url;
    }
}

<div class="vertical-menu">

    <div data-simplebar class="h-100">

        <!--- Sidemenu -->
        <div id="sidebar-menu">
            <!-- Left Menu Start -->
            <ul class="metismenu list-unstyled" id="side-menu">

                <li class="@ActiveItem("Home")">
                    <a asp-controller="Home" asp-action="Index" class="waves-effect @ActiveLink("Home")">
                        <i class="bx bx-home-circle"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                @* ── Operations: the daily work ── *@
                <permission required="@Permissions.Bookings.View,@Permissions.BlockServices.View" mode="any">
                    <li class="menu-title">Operations</li>
                </permission>
                <permission required="@Permissions.Bookings.View">
                    <li class="@ActiveItem("Booking")">
                        <a asp-controller="Booking" asp-action="Index" class="waves-effect @ActiveLink("Booking")">
                            <i class="bx bx-calendar-check"></i>
                            <span>Bookings</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.BlockServices.View">
                    @* The one dropdown in the sidebar: two lists of the same arrival files. *@
                    <li class="@ActiveItem("BlockService")">
                        <a href="javascript: void(0);" class="has-arrow waves-effect">
                            <i class="bx bx-layer"></i>
                            <span>Block Services</span>
                        </a>
                        <ul class="sub-menu" aria-expanded="false">
                            <li class="@(BlockList() == "Index" ? "mm-active" : null)">
                                <a href="@BlockListUrl("Index")" class="@(BlockList() == "Index" ? "active" : null)">Group Arrivals</a>
                            </li>
                            <li class="@(BlockList() == "SingleArrivals" ? "mm-active" : null)">
                                <a href="@BlockListUrl("SingleArrivals")" class="@(BlockList() == "SingleArrivals" ? "active" : null)">Single Arrivals</a>
                            </li>
                        </ul>
                    </li>
                </permission>

                @* ── Finance: the cost side ── *@
                <permission required="@Permissions.MoneySafes.View,@Permissions.Expenses.View" mode="any">
                    <li class="menu-title">Finance</li>
                </permission>
                <permission required="@Permissions.MoneySafes.View">
                    <li class="@ActiveItem("MoneySafe")">
                        <a asp-controller="MoneySafe" asp-action="Index" class="waves-effect @ActiveLink("MoneySafe")">
                            <i class="bx bx-wallet-alt"></i>
                            <span>Money Safes</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Expenses.View">
                    <li class="@ActiveItem("Expense")">
                        <a asp-controller="Expense" asp-action="Index" class="waves-effect @ActiveLink("Expense")">
                            <i class="bx bx-receipt"></i>
                            <span>Expenses</span>
                        </a>
                    </li>
                </permission>

                @* ── Reports: read-only, filterable, exportable views ── *@
                <permission required="@Permissions.Reports.ViewFlights,@Permissions.Reports.ViewRevenue,@Permissions.Transactions.View" mode="any">
                    <li class="menu-title">Reports</li>
                </permission>
                <permission required="@Permissions.Reports.ViewFlights">
                    <li class="@ActiveItem("Report", "Flights")">
                        <a asp-controller="Report" asp-action="Flights" class="waves-effect @ActiveLink("Report", "Flights")">
                            <i class="bx bxs-plane-alt"></i>
                            <span>Flights</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Reports.ViewRevenue">
                    <li class="@ActiveItem("Report", "Revenue")">
                        <a asp-controller="Report" asp-action="Revenue" class="waves-effect @ActiveLink("Report", "Revenue")">
                            <i class="bx bx-line-chart"></i>
                            <span>Revenue</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Transactions.View">
                    <li class="@ActiveItem("Transaction")">
                        <a asp-controller="Transaction" asp-action="Index" class="waves-effect @ActiveLink("Transaction")">
                            <i class="bx bx-dollar-circle"></i>
                            <span>Payments Received</span>
                        </a>
                    </li>
                </permission>

                @* ── Setup: catalogues edited now and then ── *@
                <permission required="@Permissions.Packages.View,@Permissions.Destinations.View,@Permissions.Tours.View,@Permissions.Nationalities.View,@Permissions.ExpenseTypes.View" mode="any">
                    <li class="menu-title">Setup</li>
                </permission>
                <permission required="@Permissions.Packages.View">
                    <li class="@ActiveItem("Package")">
                        <a asp-controller="Package" asp-action="Index" class="waves-effect @ActiveLink("Package")">
                            <i class="bx bx-package"></i>
                            <span>Packages</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Destinations.View">
                    <li class="@ActiveItem("Destination")">
                        <a asp-controller="Destination" asp-action="Index" class="waves-effect @ActiveLink("Destination")">
                            <i class="bx bx-map-pin"></i>
                            <span>Destinations</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Tours.View">
                    <li class="@ActiveItem("Tour")">
                        <a asp-controller="Tour" asp-action="Index" class="waves-effect @ActiveLink("Tour")">
                            <i class="bx bx-compass"></i>
                            <span>Extra Tours</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Nationalities.View">
                    <li class="@ActiveItem("Nationality")">
                        <a asp-controller="Nationality" asp-action="Index" class="waves-effect @ActiveLink("Nationality")">
                            <i class="bx bx-flag"></i>
                            <span>Nationalities</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.ExpenseTypes.View">
                    <li class="@ActiveItem("ExpenseType")">
                        <a asp-controller="ExpenseType" asp-action="Index" class="waves-effect @ActiveLink("ExpenseType")">
                            <i class="bx bx-purchase-tag"></i>
                            <span>Expense Types</span>
                        </a>
                    </li>
                </permission>

                @* ── Administration ── *@
                <permission required="@Permissions.Users.View,@Permissions.Roles.View" mode="any">
                    <li class="menu-title">Administration</li>
                </permission>
                <permission required="@Permissions.Users.View">
                    <li class="@ActiveItem("User")">
                        <a asp-controller="User" asp-action="Index" class="waves-effect @ActiveLink("User")">
                            <i class="bx bx-group"></i>
                            <span>Users</span>
                        </a>
                    </li>
                </permission>
                <permission required="@Permissions.Roles.View">
                    <li class="@ActiveItem("Role")">
                        <a asp-controller="Role" asp-action="Index" class="waves-effect @ActiveLink("Role")">
                            <i class="bx bx-shield-quarter"></i>
                            <span>Roles</span>
                        </a>
                    </li>
                </permission>

            </ul>
        </div>
        <!-- Sidebar -->
    </div>
</div>
