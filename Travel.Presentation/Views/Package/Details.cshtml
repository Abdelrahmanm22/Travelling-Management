@model Travel.Domain.Models.Package
@{
    ViewData["Title"] = Model.Name;
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h4 class="mb-1">@Model.Name</h4>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger">Inactive</span>
                        }
                    </div>
                    <div class="text-nowrap">
                        <permission required="@Permissions.Packages.Edit">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bx bx-pencil me-1"></i>Edit</a>
                        </permission>
                        <a asp-action="Index" class="btn btn-light btn-sm">Back</a>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded mb-4" style="max-height:280px" alt="@Model.Name" />
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-muted">@Model.Description</p>
                }

                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12">Base destination</h6>
                        <p class="mb-0 fw-semibold">@Model.BaseDestination?.Name</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase font-size-12">Total nights</h6>
                        <p class="mb-0 fw-semibold">@(Model.TotalNights.HasValue ? $"{Model.TotalNights} nights" : "Variable (set per booking)")</p>
                    </div>
                </div>

                <h5 class="mb-3">Itinerary</h5>
                <ol class="list-group list-group-numbered">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bx bx-buildings me-2"></i><strong>@Model.BaseDestination?.Name</strong> <span class="text-muted">(base, arrival)</span></span>
                        <span class="badge bg-light text-muted rounded-pill">computed per booking</span>
                    </li>
                    @foreach (var seg in Model.Segments.OrderBy(s => s.SortOrder))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                @if (seg.Destination?.IsCruise == true)
                                {
                                    <i class="bx bxs-ship me-2"></i>
                                }
                                else
                                {
                                    <i class="bx bx-buildings me-2"></i>
                                }
                                <strong>@seg.Destination?.Name</strong>
                                @if (seg.Destination?.IsCruise == true && seg.Destination.DepartureDays.HasValue)
                                {
                                    <span class="text-muted">(sails @seg.Destination.DepartureDays)</span>
                                }
                            </span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill">@seg.Nights nights</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bx bx-buildings me-2"></i><strong>@Model.BaseDestination?.Name</strong> <span class="text-muted">(return until departure)</span></span>
                        <span class="badge bg-light text-muted rounded-pill">remaining</span>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>
