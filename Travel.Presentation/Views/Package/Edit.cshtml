@model Travel.Presentation.ViewModels.PackageViewModel
@{
    ViewData["Title"] = "Edit Package";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Edit Package</h4>

                <form asp-action="Edit" method="post" enctype="multipart/form-data" id="package-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingImageUrl" />

                    <partial name="_PackageForm" model="Model" />

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/js/package-form.js"></script>
}
