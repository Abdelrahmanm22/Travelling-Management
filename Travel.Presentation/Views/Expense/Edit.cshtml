@using Travel.Presentation.Helpers
@model Travel.Presentation.ViewModels.ExpenseFormViewModel
@{
    ViewData["Title"] = "Edit Expense";
}

<link href="~/back/assets/libs/dropzone/min/dropzone.min.css" rel="stylesheet" type="text/css" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bx bx-pencil me-1"></i> Edit Expense</h4>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="bx bx-arrow-back me-1"></i> Back</a>
</div>

<div class="alert alert-info d-flex align-items-start gap-2" role="alert">
    <i class="bx bx-info-circle font-size-18"></i>
    <div>
        Correcting the cost re-derives the whole breakdown and adjusts the withdrawal in the safe.
        The safe, the expense type and the arrival groups are fixed — changing any of those is a
        different expense, so delete this one and record it again.
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="expense-form"
      data-preview-url="@Url.Action("Preview")" data-groups-url="@Url.Action("Groups")"
      data-base-currency="@Money.Code">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-xl-8">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_ExpenseForm" model="Model" />
        </div>

        <div class="col-xl-4">
            <div class="card position-sticky" style="top: 90px;">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="bx bx-list-check me-1"></i> Breakdown</h5>
                    <div id="expense-preview">
                        <div class="text-muted font-size-12">Calculating…</div>
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/back/assets/libs/dropzone/min/dropzone.min.js"></script>
    <script src="~/back/assets/js/attachment-dropzones.js"></script>
    <script src="~/back/assets/js/expense-form.js"></script>
}
